{
	"name": "@arcade/lib-multiplayer",
	"version": "0.1.0",
	"private": true,
	"description": "Shared WebRTC peer-to-peer multiplayer session hooks and signaling utilities for absolutholz Arcade monorepo",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./types": {
			"types": "./src/types.ts",
			"default": "./src/types.ts"
		},
		"./roomCode": {
			"types": "./src/roomCode.ts",
			"default": "./src/roomCode.ts"
		},
		"./useCloudRoom": {
			"types": "./src/useCloudRoom.ts",
			"default": "./src/useCloudRoom.ts"
		},
		"./useActiveRooms": {
			"types": "./src/useActiveRooms.ts",
			"default": "./src/useActiveRooms.ts"
		},
		"./notifications": {
			"types": "./src/notifications.ts",
			"default": "./src/notifications.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test src/roomCode.test.ts"
	},
	"dependencies": {
		"firebase": "catalog:"
	},
	"peerDependencies": {
		"react": "catalog:"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"react": "catalog:",
		"typescript": "^5.7.2"
	}
}
