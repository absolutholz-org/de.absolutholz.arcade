{
	"name": "@arcade/lib-multiplayer",
	"version": "0.1.0",
	"private": true,
	"description": "Shared WebRTC peer-to-peer multiplayer session hooks and signaling utilities for Arcade monorepo",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./types": {
			"types": "./src/types.ts",
			"default": "./src/types.ts"
		},
		"./roomCode": {
			"types": "./src/roomCode.ts",
			"default": "./src/roomCode.ts"
		},
		"./iceServers": {
			"types": "./src/iceServers.ts",
			"default": "./src/iceServers.ts"
		},
		"./useHostSession": {
			"types": "./src/useHostSession.ts",
			"default": "./src/useHostSession.ts"
		},
		"./useGuestSession": {
			"types": "./src/useGuestSession.ts",
			"default": "./src/useGuestSession.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test src/roomCode.test.ts"
	},
	"dependencies": {
		"peerjs": "^1.5.4"
	},
	"peerDependencies": {
		"react": "catalog:"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"react": "catalog:",
		"typescript": "^5.7.2"
	}
}
