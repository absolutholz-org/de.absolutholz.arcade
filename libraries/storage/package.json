{
	"name": "@arcade/lib-storage",
	"version": "0.1.0",
	"private": true,
	"description": "Unified asynchronous namespaced storage library for Arcade monorepo",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/createGameStorage.ts",
			"default": "./src/createGameStorage.ts"
		},
		"./drivers/*": {
			"types": "./src/drivers/*.ts",
			"default": "./src/drivers/*.ts"
		},
		"./types/*": {
			"types": "./src/types/*.ts",
			"default": "./src/types/*.ts"
		},
		"./utils/*": {
			"types": "./src/utils/*.ts",
			"default": "./src/utils/*.ts"
		},
		"./stats": {
			"types": "./src/stats.ts",
			"default": "./src/stats.ts"
		},
		"./stats.js": {
			"types": "./src/stats.ts",
			"default": "./src/stats.ts"
		},
		"./pwa/*": {
			"types": "./src/pwa/*.ts",
			"default": "./src/pwa/*.ts"
		},
		"./pwa/offlineBridge": {
			"types": "./src/pwa/offlineBridge.ts",
			"default": "./src/pwa/offlineBridge.ts"
		},
		"./pwa/offlineBridge.js": {
			"types": "./src/pwa/offlineBridge.ts",
			"default": "./src/pwa/offlineBridge.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"typescript": "^5.7.2",
		"vitest": "^4.1.8"
	}
}
