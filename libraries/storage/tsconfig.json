{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"composite": true,
		"baseUrl": ".",
		"paths": {
			"react": ["../../node_modules/@types/react"]
		},
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/**/*"]
}
