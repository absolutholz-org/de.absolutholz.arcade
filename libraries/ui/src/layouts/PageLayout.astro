---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { HeaderActions } from '../components/HeaderActions';
import { Logo } from '../components/Logo';
import { SiteFooter } from '../components/SiteFooter';
import { SiteHeader } from '../components/SiteHeader';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	lang: SupportedLanguageCode;
	appTitle: string;
	appHomeHref: string;
	currentSlug?: string;
	basePath?: string;
	canonicalBase?: string;
	contentProse?: boolean;
	manifestHref?: string;
	headerVariant?: 'standard' | 'minimal' | 'none';
}

const {
	title,
	description,
	lang,
	appTitle,
	appHomeHref,
	currentSlug = '',
	basePath = '',
	canonicalBase = 'https://arcade.absolutholz.de',
	contentProse = true,
	manifestHref,
	headerVariant = 'standard',
} = Astro.props;

const currentCommon = resources[lang]?.common ?? resources.en.common;
const pathPrefix = basePath ? `/${basePath}` : '';

const pageTitle = currentSlug
	? `${title} | ${appTitle}`
	: title !== appTitle && title
		? `${title} | ${appTitle}`
		: appTitle;
const pageDescription = description || currentCommon.app.tagline;

const alternateUrls = SUPPORTED_LANGUAGES.map((item) => ({
	code: item.code,
	label: item.label,
	flag: item.flag,
	href: currentSlug ? `${pathPrefix}/${item.code}/${currentSlug}` : `${pathPrefix}/${item.code}/`,
}));

const isGermanOrEnglish = lang === 'en' || lang === 'de';

const legalLinks = [
	{
		href: isGermanOrEnglish ? `/${lang}/privacy` : '/en/privacy',
		hrefLang: isGermanOrEnglish ? lang : 'en',
		label: isGermanOrEnglish ? currentCommon.navigation.privacy : `${currentCommon.navigation.privacy} (EN)`,
	},
	{
		href: isGermanOrEnglish ? `/${lang}/imprint` : '/en/imprint',
		hrefLang: isGermanOrEnglish ? lang : 'en',
		label: isGermanOrEnglish ? currentCommon.navigation.imprint : `${currentCommon.navigation.imprint} (EN)`,
	},
	{
		href: `/${lang}/accessibility`,
		hrefLang: lang,
		label: currentCommon.navigation.accessibility,
	},
	{
		href: `/${lang}/settings`,
		hrefLang: lang,
		label: currentCommon.navigation.settings,
	},
];

const resourceLinks = [
	{
		external: true,
		href: 'https://github.com/absolutholz-org/de.absolutholz.arcade',
		label: 'GitHub',
	},
	{
		external: true,
		href: '/storybook',
		label: 'Storybook',
	},
];

const canonicalPath = currentSlug ? `${pathPrefix}/${lang}/${currentSlug}` : `${pathPrefix}/${lang}/`;
const canonicalUrl = `${canonicalBase}${canonicalPath}`;
---

<BaseLayout
	lang={lang}
	dir="ltr"
	title={pageTitle}
	description={pageDescription}
	canonical={canonicalUrl}
	appTitle={appTitle}
	manifestHref={manifestHref}
>
	<Fragment slot="head">
		{alternateUrls.map((alt) => (
			<link rel="alternate" hreflang={alt.code} href={`${canonicalBase}${alt.href}`} />
		))}
		<link
			rel="alternate"
			hreflang="x-default"
			href={`${canonicalBase}${currentSlug ? `${pathPrefix}/en/${currentSlug}` : `${pathPrefix}/en/`}`}
		/>
		<slot name="head" />
	</Fragment>

	<a href="#main-content" class="skip-link">{currentCommon.navigation.skipToContent}</a>

	{
		headerVariant === 'standard' && (
			<SiteHeader>
				<div class="header-container">
					<div class="header-brand">
						<a href={`/${lang}/`} class="header-logo-link" aria-label={currentCommon.navigation.home}>
							<Logo size="sm" />
						</a>
						<a href={appHomeHref} class="header-app-title-link">
							<span class="header-app-title">{appTitle}</span>
						</a>
					</div>

					<HeaderActions client:load lang={lang} currentSlug={currentSlug} />
				</div>
			</SiteHeader>
		)
	}

	{
		headerVariant === 'minimal' && (
			<div class="utility-bar">
				<div class="utility-bar-container">
					<HeaderActions client:load lang={lang} currentSlug={currentSlug} />
				</div>
			</div>
		)
	}

	<main
		id="main-content"
		class:list={['site-main', { 'site-main--minimal-header': headerVariant === 'minimal' }]}
	>
		{contentProse ? (
			<article class="page-container prose">
				<slot />
			</article>
		) : (
			<slot />
		)}
	</main>

	<SiteFooter
		legalAriaLabel={currentCommon.navigation.legal}
		legalLinks={legalLinks}
		copyright={{
			startYear: 2024,
			currentYear: new Date().getFullYear(),
			owner: 'absolutholz',
		}}
		version="0.1.0"
		resourceLinks={resourceLinks}
	/>
</BaseLayout>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.skip-link {
		background: var(--color-accent);
		border-radius: var(--radius-sm);
		color: #fff;
		left: 1rem;
		padding: 0.5rem 1rem;
		position: absolute;
		top: -3rem;
		transition: top 150ms ease;
		z-index: 100;
	}

	.skip-link:focus {
		top: 1rem;
	}

	.header-container {
		align-items: center;
		display: flex;
		height: 100%;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 64rem;
		width: 100%;
	}

	.header-brand {
		align-items: center;
		display: inline-flex;
		gap: 0.75rem;
	}

	.header-logo-link {
		align-items: center;
		display: inline-flex;
		text-decoration: none;
	}

	.header-app-title-link {
		align-items: center;
		color: var(--color-text-1);
		display: inline-flex;
		text-decoration: none;
	}

	.header-app-title-link:hover .header-app-title {
		color: var(--color-accent);
	}

	.header-app-title-link:focus-visible {
		border-radius: var(--radius-sm);
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.header-app-title {
		color: inherit;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.2;
		transition: color 120ms ease;
	}

	.utility-bar {
		box-sizing: border-box;
		display: flex;
		justify-content: flex-end;
		padding: 1rem var(--page-content-padding, 1.5rem) 0;
		width: 100%;
	}

	.utility-bar-container {
		display: flex;
		justify-content: flex-end;
		margin: 0 auto;
		max-width: 64rem;
		width: 100%;
	}

	.site-main {
		flex: 1;
		padding: 2.5rem 1.5rem;
		width: 100%;
	}

	.site-main--minimal-header {
		padding-top: 1.5rem;
	}

	.page-container {
		margin: 0 auto;
		max-width: 48rem;
	}

	.prose :global(h1) {
		font-size: 2.25rem;
		line-height: 1.2;
		margin-bottom: 1.5rem;
	}

	.prose :global(h2) {
		border-bottom: 1px solid var(--color-container-2);
		font-size: 1.5rem;
		margin-bottom: 0.75rem;
		margin-top: 2rem;
		padding-bottom: 0.5rem;
	}

	.prose :global(h3) {
		font-size: 1.125rem;
		margin-bottom: 0.5rem;
		margin-top: 1.25rem;
	}

	.prose :global(p) {
		margin-bottom: 1rem;
	}

	.prose :global(ul) {
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.375rem;
	}

	.prose :global(a:not([data-variant])) {
		color: var(--color-accent);
	}
</style>
