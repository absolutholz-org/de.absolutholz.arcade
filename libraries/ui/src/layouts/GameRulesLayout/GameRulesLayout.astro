---
import { Button } from '../../components/Button';
import { HeaderUserMenu } from '../../components/HeaderUserMenu';
import { MarkdownContent } from '../../components/MarkdownContent';
import { Stack } from '../../components/Stack';
import StaticPageLayout from '../StaticPageLayout/StaticPageLayout.astro';
import type { GameRulesLayoutProps } from './_GameRulesLayout.types';

type Props = GameRulesLayoutProps;

const {
	title,
	description,
	lang,
	appTitle,
	appHomeHref,
	basePath,
	currentSlug = 'rules',
	primaryActionLabel,
	primaryActionHref,
	headerVariant = 'standard',
} = Astro.props;

const resolvedHomeHref = appHomeHref || `/${basePath}/${lang}/`;
const resolvedActionHref = primaryActionHref || resolvedHomeHref;
---

<StaticPageLayout
	title={title}
	description={description}
	lang={lang}
	appTitle={appTitle}
	appHomeHref={resolvedHomeHref}
	basePath={basePath}
	currentSlug={currentSlug}
	headerVariant={headerVariant}
	containerVariant="slim"
>
	<slot name="head" slot="head" />
	<slot name="header-actions" slot="header-actions">
		<HeaderUserMenu client:load lang={lang} />
	</slot>

	<Stack align="center" spacing="3xl">
		<MarkdownContent>
			<slot />
		</MarkdownContent>

		{
			primaryActionLabel && (
				<Button as="a" href={resolvedActionHref} variant="primary" size="md">
					{primaryActionLabel}
				</Button>
			)
		}
	</Stack>
</StaticPageLayout>
