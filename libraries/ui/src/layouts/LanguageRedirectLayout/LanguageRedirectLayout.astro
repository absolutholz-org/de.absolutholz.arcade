---
import type { GameId } from '@arcade/lib-games';
import { resources } from '@arcade/lib-i18n/config/i18n';
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import { LanguageRedirectFallback } from '../../components/LanguageRedirectFallback';
import BaseLayoutWithSiteHeaderAndSiteFooter from '../BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';

export interface Props {
	gameId?: GameId | string;
	title?: string;
	appTitle?: string;
}

const { gameId, title: customTitle, appTitle: customAppTitle } = Astro.props;

const currentCommon = resources[DEFAULT_LANGUAGE].common;
const gameResource = gameId ? (resources[DEFAULT_LANGUAGE] as Record<string, any>)[gameId] : undefined;

const title = customTitle ?? gameResource?.title ?? currentCommon.app.title;
const appTitle = customAppTitle ?? (gameId ? gameId.charAt(0).toUpperCase() + gameId.slice(1) : undefined);
const basePath = gameId ? `/${gameId}` : '';
const canonical = `https://arcade.absolutholz.de${basePath}/${DEFAULT_LANGUAGE}/`;

const languageItems = SUPPORTED_LANGUAGES.map((item) => ({
	code: item.code,
	label: item.label,
	flag: item.flag,
	href: `${basePath}/${item.code}/`,
}));
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	lang={DEFAULT_LANGUAGE}
	title={title}
	canonical={canonical}
	appTitle={appTitle}
>
	<Fragment slot="head">
		{/* Non-JS fallback redirect to default language */}
		<meta http-equiv="refresh" content={`0;url=${basePath}/${DEFAULT_LANGUAGE}/`} />

		<script is:inline define:vars={{ supportedCodes: SUPPORTED_LANGUAGES.map((l) => l.code), defaultLang: DEFAULT_LANGUAGE, basePath }}>
			(function () {
				function redirect(lang) {
					try {
						// Store language preference cookie to accelerate future .htaccess requests
						document.cookie = 'arcade_lang=' + lang + '; path=/; max-age=31536000; SameSite=Lax';
					} catch (_) {}
					window.location.replace(basePath + '/' + lang + '/');
				}

				try {
					var stored = localStorage.getItem('arcade::i18n::language');
					if (stored && supportedCodes.indexOf(stored) !== -1) {
						redirect(stored);
						return;
					}
				} catch (_) {}

				var candidates = navigator.languages || [navigator.language || ''];
				for (var i = 0; i < candidates.length; i++) {
					var candidate = (candidates[i] || '').toLowerCase().split('-')[0];
					if (supportedCodes.indexOf(candidate) !== -1) {
						redirect(candidate);
						return;
					}
				}

				redirect(defaultLang);
			})();
		</script>
	</Fragment>

	<LanguageRedirectFallback
		title={title}
		message={currentCommon.app.redirectNotice}
		languagesAriaLabel={currentCommon.switchers.language.ariaLabel}
		languages={languageItems}
	/>
</BaseLayoutWithSiteHeaderAndSiteFooter>
