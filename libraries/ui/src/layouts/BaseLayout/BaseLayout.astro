---
import '../../styles/global.css';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { MedalToastListener } from '../../components/MedalToastListener';
import { Toast } from '../../components/Toast';
import type { BaseLayoutProps } from './_BaseLayout.types';

type Props = BaseLayoutProps;

const {
	title,
	description,
	lang = 'en',
	dir = 'ltr',
	canonical,
	appTitle = 'Arcade',
	manifestHref = '/site.webmanifest',
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script is:inline>
			(() => {
				try {
					const storedTheme = localStorage.getItem('arcade::ui::themeset');
					if (storedTheme && storedTheme !== 'base') {
						document.documentElement.dataset.themeset = storedTheme;
					}
					const storedScheme = localStorage.getItem('arcade::ui::scheme');
					if (storedScheme && storedScheme !== 'system') {
						document.documentElement.style.colorScheme = storedScheme;
					}
				} catch {}
			})();
		</script>
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch((err) => {
						console.error('Service Worker registration failed:', err);
					});
				});
			}
		</script>
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="icon" type="image/png" href="/favicon-96x96.png?v=20261006" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261006" />
		<link rel="shortcut icon" href="/favicon.ico?v=20261006" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20261006" />
		<meta name="apple-mobile-web-app-title" content={appTitle} />
		{manifestHref && <link rel="manifest" href={manifestHref} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<slot name="head" />
	</head>
	<body>
		<slot />
		<Toast client:load />
		<MedalToastListener client:load lang={lang as SupportedLanguageCode} />
	</body>
</html>
