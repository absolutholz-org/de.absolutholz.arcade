---
import { Breadcrumb } from '../../components/Breadcrumb';
import type { BreadcrumbItem } from '../../components/Breadcrumb/_Breadcrumb.types';
import { Button } from '../../components/Button';
import { Hero } from '../../components/Hero';
import { PageContainer } from '../../components/PageContainer';
import type { PageContainerVariant } from '../../components/PageContainer/_PageContainer.types';
import { Stack } from '../../components/Stack';
import type { BaseLayoutProps } from '../../layouts/BaseLayout/_BaseLayout.types';
import BaseLayoutWithSiteHeaderAndSiteFooter from '../../layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import type { GameSubpageActionItem } from './_GameSubpageTemplate.types';

interface Props extends BaseLayoutProps {
	title: string;
	subtitle?: string;
	breadcrumbItems?: BreadcrumbItem[];
	containerWidth?: PageContainerVariant;
	currentSlug?: string;
	hideBrand?: boolean;
	hasBorder?: boolean;
	primaryAction?: GameSubpageActionItem;
	secondaryAction?: GameSubpageActionItem;
}

const {
	title,
	subtitle,
	breadcrumbItems,
	containerWidth = 'standard',
	primaryAction,
	secondaryAction,
	...layoutProps
} = Astro.props;

const hasSlotActions = Astro.slots.has('action') || Astro.slots.has('actions');
const hasActionProps = Boolean(primaryAction || secondaryAction);
const hasActions = hasSlotActions || hasActionProps;
---

<BaseLayoutWithSiteHeaderAndSiteFooter title={title} {...layoutProps}>
	<slot name="head" slot="head" />

	<PageContainer variant={containerWidth}>
		{
			breadcrumbItems && breadcrumbItems.length > 0 ? (
				<Breadcrumb items={breadcrumbItems} client:load />
			) : (
				<slot name="breadcrumb" />
			)
		}

		{Astro.slots.has("hero") ? <slot name="hero" /> : <Hero title={title}>{subtitle}</Hero>}

		<slot />

		{
			hasActions ? (
				<footer class="subpage-footer">
					<Stack align="center" direction="row" spacing="md" justify="center" wrap>
						{hasSlotActions ? (
							<>
								<slot name="action" />
								<slot name="actions" />
							</>
						) : (
							<>
								{primaryAction && (
									<Button
										as="a"
										href={primaryAction.href}
										variant="primary"
										size="lg"
										aria-label={primaryAction.ariaLabel}
									>
										{primaryAction.label}
									</Button>
								)}
								{secondaryAction && (
									<Button
										as="a"
										href={secondaryAction.href}
										variant="secondary"
										size="lg"
										aria-label={secondaryAction.ariaLabel}
									>
										{secondaryAction.label}
									</Button>
								)}
							</>
						)}
					</Stack>
				</footer>
			) : null
		}
	</PageContainer>
</BaseLayoutWithSiteHeaderAndSiteFooter>

<style>
	.subpage-footer {
		border-top: 1px solid var(--color-container-2);
		margin-top: var(--space-xl);
		padding-top: var(--space-xl);
	}
</style>
