---
import { Breadcrumb } from '../../components/Breadcrumb';
import type { BreadcrumbItem } from '../../components/Breadcrumb/_Breadcrumb.types';
import { Hero } from '../../components/Hero';
import { MarkdownContent } from '../../components/MarkdownContent';
import { PageContainer } from '../../components/PageContainer';
import type { PageContainerVariant } from '../../components/PageContainer/_PageContainer.types';
import type { BaseLayoutProps } from '../../layouts/BaseLayout/_BaseLayout.types';
import BaseLayoutWithSiteHeaderAndSiteFooter from '../../layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';

interface Props extends BaseLayoutProps {
	title?: string;
	breadcrumbItems?: BreadcrumbItem[];
	containerWidth?: PageContainerVariant;
	currentSlug?: string;
	hideBrand?: boolean;
	hasBorder?: boolean;
}

const { title: propTitle, breadcrumbItems, containerWidth = 'slim', ...layoutProps } = Astro.props;

let contentHtml = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
let resolvedTitle = propTitle;

// Recognize and extract the first H1 from the rendered markdown content
const h1Match = contentHtml.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
if (h1Match) {
	if (!resolvedTitle) {
		resolvedTitle = h1Match[1].replace(/<[^>]+>/g, '').trim();
	}
	// Strip the H1 from the markdown content so it is not rendered twice
	contentHtml = contentHtml.replace(/<h1[^>]*>[\s\S]*?<\/h1>/i, '');
}
---

<BaseLayoutWithSiteHeaderAndSiteFooter title={resolvedTitle ?? ''} {...layoutProps}>
	<slot name="head" slot="head" />

	<PageContainer variant={containerWidth}>
		{breadcrumbItems && breadcrumbItems.length > 0 ? (
			<Breadcrumb items={breadcrumbItems} client:load />
		) : (
			<slot name="breadcrumb" />
		)}

		<Hero title={resolvedTitle ?? ''} />

		<MarkdownContent>
			<Fragment set:html={contentHtml} />
		</MarkdownContent>

		{Astro.slots.has('action') ? (
			<div class="template-action">
				<slot name="action" />
			</div>
		) : null}
	</PageContainer>
</BaseLayoutWithSiteHeaderAndSiteFooter>

		{Astro.slots.has('action') ? (
			<div class="template-action">
				<slot name="action" />
			</div>
		) : null}
	</PageContainer>
</BaseLayoutWithSiteHeaderAndSiteFooter>

<style>
	.template-action {
		align-items: center;
		border-top: 1px solid var(--color-container-2);
		display: flex;
		justify-content: center;
		margin-top: var(--space-3xl);
		padding-top: var(--space-2xl);
	}
</style>
