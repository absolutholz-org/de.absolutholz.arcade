{
	"name": "@arcade/lib-ui",
	"version": "0.1.0",
	"private": true,
	"description": "Design system package for Arcade monorepo",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./audio/*": {
			"types": "./src/audio/*.ts",
			"default": "./src/audio/*.ts"
		},
		"./components/*": {
			"types": "./src/components/*/index.ts",
			"default": "./src/components/*/index.ts"
		},
		"./hooks/*": {
			"types": "./src/hooks/*.ts",
			"default": "./src/hooks/*.ts"
		},
		"./styles/*": {
			"types": "./src/styles/*.ts",
			"default": "./src/styles/*.ts"
		},
		"./layouts/*.astro": "./src/layouts/*.astro",
		"./layouts/*": {
			"types": "./src/layouts/*/index.ts",
			"default": "./src/layouts/*/index.ts"
		},
		"./templates/*.astro": "./src/templates/*.astro",
		"./templates/*": {
			"types": "./src/templates/*/index.ts",
			"default": "./src/templates/*/index.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@babel/preset-react": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@chromatic-com/storybook": "^5.6.0",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-mcp": "^10.6.5",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"@wyw-in-js/vite": "^1.1.0",
		"playwright": "^1.60.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"storybook": "^10.6.5",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"dependencies": {
		"@arcade/lib-consent": "workspace:*",
		"@arcade/lib-dice": "workspace:*",
		"@arcade/lib-games": "workspace:*",
		"@arcade/lib-i18n": "workspace:*",
		"@arcade/lib-medals": "workspace:*",
		"@arcade/lib-storage": "workspace:*",
		"@arcade/lib-user": "workspace:*",
		"@linaria/babel-preset": "^5.0.4",
		"@linaria/core": "catalog:",
		"@linaria/react": "catalog:",
		"react-i18next": "catalog:"
	}
}
