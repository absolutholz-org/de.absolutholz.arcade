{
	"name": "@arcade/lib-user",
	"version": "0.1.0",
	"private": true,
	"description": "Unified user identity, session management, and cloud persistence facade for Arcade monorepo",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@arcade/lib-consent": "workspace:*",
		"@arcade/lib-storage": "workspace:*",
		"firebase": "catalog:",
		"@arcade/lib-medals": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.7.2",
		"vitest": "^4.1.8"
	}
}
