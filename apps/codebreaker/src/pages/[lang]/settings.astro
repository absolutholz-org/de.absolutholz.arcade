---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameSettingsPanel } from '@arcade/lib-ui/components/GameSettingsPanel';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';
import { CODEBREAKER_SETTINGS_CONFIG } from '../../config/settings';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentCodebreaker = resources[currentLanguage]?.codebreaker ?? resources.en.codebreaker;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentCodebreaker.settings.title}
	description={`${currentCodebreaker.title} - ${currentCodebreaker.settings.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: `${currentCommon.app.shortTitle} ${currentCommon.navigation.home}`, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentCodebreaker.title, href: `/codebreaker/${currentLanguage}/` },
		{ label: currentCodebreaker.settings.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentCodebreaker.controls.newGame,
		href: `/codebreaker/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentCodebreaker.controls.backToLobby,
		href: `/codebreaker/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="settings"
>
	<GameSettingsPanel
		client:load
		config={CODEBREAKER_SETTINGS_CONFIG}
		lang={currentLanguage}
		mode="detailed"
	/>
</GameSubpageTemplate>
