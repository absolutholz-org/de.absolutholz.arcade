---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameStatsDashboard } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentNonogram = resources[currentLanguage]?.nonogram ?? resources.en.nonogram;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentCommon.stats.title}
	subtitle={`${currentNonogram.title} — ${currentCommon.stats.title}`}
	description={`${currentNonogram.title} - ${currentCommon.stats.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentNonogram.title, href: `/nonogram/${currentLanguage}/` },
		{ label: currentCommon.stats.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentNonogram.controls.play,
		href: `/nonogram/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentNonogram.controls.backToLobby,
		href: `/nonogram/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="stats"
>
	<GameStatsDashboard
		client:load
		gameId="nonogram"
		lang={currentLanguage}
		hideTitle
		bucketLabels={{
			easy: currentNonogram.difficulty.easy,
			medium: currentNonogram.difficulty.medium,
			hard: currentNonogram.difficulty.hard,
		}}
		playHref={`/nonogram/${currentLanguage}/game`}
	/>
</GameSubpageTemplate>
