---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { NONOGRAM_MEDAL_DEFINITIONS } from '@arcade/lib-medals';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import { NonogramMedalGrid } from '../../components/NonogramMedalGrid';
import type { NonogramMedalDefinitionItem } from '../../components/NonogramMedalGrid/NonogramMedalGrid.types';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentNonogram = resources[currentLanguage]?.nonogram ?? resources.en.nonogram;
const currentMedals = resources[currentLanguage]?.medals ?? resources.en.medals;

// Build-time static definitions for Nonogram medals
const staticMedals: NonogramMedalDefinitionItem[] = NONOGRAM_MEDAL_DEFINITIONS.map((def) => {
	const key = def.id.replace('nonogram_', '') as keyof typeof currentMedals.nonogram;
	const localized = currentMedals.nonogram[key];
	let target: number | undefined;
	if (def.thresholds) {
		target = def.thresholds.gold;
	} else if (def.id === 'nonogram_first_brushstroke' || def.id === 'nonogram_college_try') {
		target = 1;
	} else if (def.id === 'nonogram_playing_safe') {
		target = 15;
	} else if (def.id === 'nonogram_indecisive') {
		target = 5;
	}

	return {
		id: def.id,
		type: def.type ?? 'standalone',
		tier: def.tier,
		title: localized?.title ?? def.id,
		description: localized?.desc ?? '',
		icon: def.icon,
		target,
		thresholds: def.thresholds,
	};
});
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	title={currentMedals.showcase.title}
	description={`${currentNonogram.title} - ${currentMedals.showcase.description}`}
	lang={currentLanguage}
	currentSlug="medals"
>
	<PageContainer variant="wide">
	<NonogramMedalGrid client:load lang={currentLanguage} staticMedals={staticMedals} />
	</PageContainer>
</BaseLayoutWithSiteHeaderAndSiteFooter>
