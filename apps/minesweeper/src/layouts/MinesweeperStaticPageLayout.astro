---
import { resources } from '@arcade/lib-i18n/config/i18n';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import StaticPageLayout from '@arcade/lib-ui/layouts/StaticPageLayout.astro';

interface Props {
	title: string;
	description?: string;
	lang: SupportedLanguageCode;
	currentSlug?: string;
}

const { title, description, lang, currentSlug = '' } = Astro.props;

const currentMinesweeper = resources[lang]?.minesweeper ?? resources.en.minesweeper;
---

<StaticPageLayout
	lang={lang}
	title={title}
	description={description || currentMinesweeper.description}
	appTitle={currentMinesweeper.title}
	appHomeHref={`/minesweeper/${lang}/`}
	basePath="minesweeper"
	currentSlug={currentSlug}
>
	<slot name="head" slot="head" />
	<slot />
</StaticPageLayout>
