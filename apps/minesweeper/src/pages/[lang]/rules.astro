---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { Button } from '@arcade/lib-ui/components/Button';
import MinesweeperPageLayout from '../../layouts/MinesweeperPageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentMinesweeper = resources[lang as SupportedLanguageCode]?.minesweeper ?? resources.en.minesweeper;
---

<MinesweeperPageLayout
	title={currentMinesweeper.rules.title}
	description={currentMinesweeper.rules.objective}
	lang={lang as SupportedLanguageCode}
	currentSlug="rules"
>
	<h1>{currentMinesweeper.rules.title}</h1>

	<section class="rules-section">
		<h2>{currentMinesweeper.rules.objectiveTitle}</h2>
		<p>{currentMinesweeper.rules.objective}</p>
	</section>

	<section class="rules-section">
		<h2>{currentMinesweeper.rules.rule1Title}</h2>
		<p>{currentMinesweeper.rules.rule1}</p>
	</section>

	<section class="rules-section">
		<h2>{currentMinesweeper.rules.rule2Title}</h2>
		<p>{currentMinesweeper.rules.rule2}</p>
	</section>

	<section class="rules-section">
		<h2>{currentMinesweeper.rules.rule3Title}</h2>
		<p>{currentMinesweeper.rules.rule3}</p>
	</section>

	<div class="rules-actions">
		<Button as="a" href={`/minesweeper/${lang}/`} variant="primary" size="md">
			{currentMinesweeper.controls.newGame}
		</Button>
	</div>
</MinesweeperPageLayout>

<style>
	.rules-section {
		margin-bottom: 2rem;
	}

	.rules-section h2 {
		color: var(--color-text-1);
		font-size: 1.375rem;
		margin-bottom: 0.5rem;
	}

	.rules-section p {
		color: var(--color-text-2);
		line-height: 1.6;
		margin: 0;
	}

	.rules-actions {
		display: flex;
		justify-content: center;
		margin-top: 2.5rem;
	}
</style>
