---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { MinesweeperLobby } from '../../components/MinesweeperLobby';
import MinesweeperPageLayout from '../../layouts/MinesweeperPageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentMinesweeper = resources[lang as SupportedLanguageCode]?.minesweeper ?? resources.en.minesweeper;
---

<MinesweeperPageLayout
	title={currentMinesweeper.title}
	description={currentMinesweeper.description}
	lang={lang as SupportedLanguageCode}
	currentSlug=""
	contentProse={false}
>
	<MinesweeperLobby client:load lang={lang as SupportedLanguageCode} />
</MinesweeperPageLayout>
