---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameSettingsPanel } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';
import { MINESWEEPER_SETTINGS_CONFIG } from '../../config/settings';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentMinesweeper = resources[currentLanguage]?.minesweeper ?? resources.en.minesweeper;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentMinesweeper.settings.title}
	subtitle={`${currentMinesweeper.title} — ${currentMinesweeper.settings.title}`}
	description={`${currentMinesweeper.title} - ${currentMinesweeper.settings.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentMinesweeper.title, href: `/minesweeper/${currentLanguage}/` },
		{ label: currentMinesweeper.settings.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentMinesweeper.controls.play,
		href: `/minesweeper/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentMinesweeper.controls.backToLobby,
		href: `/minesweeper/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="settings"
>
	<GameSettingsPanel
		client:load
		config={MINESWEEPER_SETTINGS_CONFIG}
		lang={currentLanguage}
		mode="detailed"
	/>
</GameSubpageTemplate>
