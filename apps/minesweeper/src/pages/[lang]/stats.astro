---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameStatsDashboard } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentMinesweeper = resources[currentLanguage]?.minesweeper ?? resources.en.minesweeper;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentCommon.stats.title}
	description={`${currentMinesweeper.title} - ${currentCommon.stats.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentMinesweeper.title, href: `/minesweeper/${currentLanguage}/` },
		{ label: currentCommon.stats.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentMinesweeper.controls.play,
		href: `/minesweeper/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentMinesweeper.controls.backToLobby,
		href: `/minesweeper/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="stats"
>
	<GameStatsDashboard
		client:load
		gameId="minesweeper"
		lang={currentLanguage}
		hideTitle
		bucketLabels={{
			simple: currentMinesweeper.difficulty.simple,
			medium: currentMinesweeper.difficulty.medium,
			hard: currentMinesweeper.difficulty.hard,
			expert: currentMinesweeper.difficulty.expert,
		}}
		playHref={`/minesweeper/${currentLanguage}/game`}
	/>
</GameSubpageTemplate>
