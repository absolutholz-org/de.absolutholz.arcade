---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { MINESWEEPER_MEDAL_DEFINITIONS } from '@arcade/lib-medals';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import { MinesweeperMedalGrid } from '../../components/MinesweeperMedalGrid';
import type { MinesweeperMedalDefinitionItem } from '../../components/MinesweeperMedalGrid/MinesweeperMedalGrid.types';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentMinesweeper = resources[currentLanguage]?.minesweeper ?? resources.en.minesweeper;
const currentMedals = resources[currentLanguage]?.medals ?? resources.en.medals;

// Build-time static definitions for Minesweeper medals
const staticMedals: MinesweeperMedalDefinitionItem[] = MINESWEEPER_MEDAL_DEFINITIONS.map((def) => {
	const key = def.id.replace('minesweeper_', '') as keyof typeof currentMedals.minesweeper;
	const localized = currentMedals.minesweeper[key];
	let target: number | undefined;
	if (def.thresholds) {
		target = def.thresholds.gold;
	} else if (def.id === 'minesweeper_clearance_initiated' || def.id === 'minesweeper_college_try') {
		target = 1;
	} else if (def.id === 'minesweeper_chord_master') {
		target = 15;
	} else if (def.id === 'minesweeper_great_cascade') {
		target = 20;
	}

	return {
		id: def.id,
		type: def.type ?? 'standalone',
		tier: def.tier,
		title: localized?.title ?? def.id,
		description: localized?.desc ?? '',
		icon: def.icon,
		target,
		thresholds: def.thresholds,
	};
});
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	title={currentMedals.showcase.title}
	description={`${currentMinesweeper.title} - ${currentMedals.showcase.description}`}
	lang={currentLanguage}
	currentSlug="medals"
>
	<PageContainer variant="wide">
	<MinesweeperMedalGrid client:load lang={currentLanguage} staticMedals={staticMedals} />
	</PageContainer>
</BaseLayoutWithSiteHeaderAndSiteFooter>
