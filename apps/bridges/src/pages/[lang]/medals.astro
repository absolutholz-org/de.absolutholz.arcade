---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { BRIDGES_MEDAL_DEFINITIONS } from '@arcade/lib-medals';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import { BridgesMedalGrid } from '../../components/BridgesMedalGrid';
import type { BridgesMedalDefinitionItem } from '../../components/BridgesMedalGrid/BridgesMedalGrid.types';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentBridges = resources[currentLanguage]?.bridges ?? resources.en.bridges;
const currentMedals = resources[currentLanguage]?.medals ?? resources.en.medals;

// Build-time static definitions for Bridges medals
const staticMedals: BridgesMedalDefinitionItem[] = BRIDGES_MEDAL_DEFINITIONS.map((def) => {
	const key = def.id.replace('bridges_', '') as keyof typeof currentMedals.bridges;
	const localized = currentMedals.bridges[key];
	let target: number | undefined;
	if (def.thresholds) {
		target = def.thresholds.gold;
	} else if (def.id === 'bridges_first_span' || def.id === 'bridges_college_try') {
		target = 1;
	} else if (def.id === 'bridges_traffic_jam') {
		target = 5;
	} else if (def.id === 'bridges_indecisive_engineer') {
		target = 6;
	}

	return {
		id: def.id,
		type: def.type ?? 'standalone',
		tier: def.tier,
		title: localized?.title ?? def.id,
		description: localized?.desc ?? '',
		icon: def.icon,
		target,
		thresholds: def.thresholds,
	};
});
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	title={currentMedals.showcase.title}
	description={`${currentBridges.title} - ${currentMedals.showcase.description}`}
	lang={currentLanguage}
	currentSlug="medals"
>
	<PageContainer variant="wide">
	<BridgesMedalGrid client:load lang={currentLanguage} staticMedals={staticMedals} />
	</PageContainer>
</BaseLayoutWithSiteHeaderAndSiteFooter>
