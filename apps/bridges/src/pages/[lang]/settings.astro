---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameSettingsPanel } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';
import { BRIDGES_SETTINGS_CONFIG } from '../../config/settings';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentBridges = resources[currentLanguage]?.bridges ?? resources.en.bridges;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentBridges.settings.title}
	description={`${currentBridges.title} - ${currentBridges.settings.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentBridges.title, href: `/bridges/${currentLanguage}/` },
		{ label: currentBridges.settings.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentBridges.controls.play,
		href: `/bridges/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentBridges.controls.backToLobby,
		href: `/bridges/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="settings"
>
	<GameSettingsPanel
		client:load
		config={BRIDGES_SETTINGS_CONFIG}
		lang={currentLanguage}
		mode="detailed"
	/>
</GameSubpageTemplate>
