---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import GameLayout from '@arcade/lib-ui/layouts/GameLayout/GameLayout.astro';
import { HashiGame } from '../../components/HashiGame';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentBridges = resources[lang as SupportedLanguageCode]?.bridges ?? resources.en.bridges;
---

<GameLayout
	title={`${currentBridges.title} | ${currentBridges.description}`}
	description={currentBridges.description}
	lang={lang as SupportedLanguageCode}
	canonical={`https://arcade.absolutholz.de/bridges/${lang}/game`}
	appTitle="Bridges"
>
	<HashiGame client:only="react" lang={lang as SupportedLanguageCode} />
</GameLayout>
