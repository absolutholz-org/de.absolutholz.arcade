---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import { PentominoesLobby } from '../../components/PentominoesLobby/PentominoesLobby.tsx';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentPentominoes = resources[currentLanguage]?.pentominoes ?? resources.en.pentominoes;

const videoGameJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'VideoGame',
	name: currentPentominoes.title,
	description: currentPentominoes.description,
	genre: ['Spatial Puzzle', 'Logic Puzzle'],
	playMode: 'SinglePlayer',
	applicationCategory: 'Game',
	operatingSystem: 'Web Browser',
	inLanguage: currentLanguage,
	url: `https://arcade.absolutholz.de/pentominoes/${currentLanguage}/`,
};
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	titleOptions={{
		scope: currentPentominoes.title,
	}}
	description={currentPentominoes.description}
	lang={currentLanguage}
	currentSlug=""
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(videoGameJsonLd)}
	/>
	<PentominoesLobby client:load lang={currentLanguage} />
</BaseLayoutWithSiteHeaderAndSiteFooter>
