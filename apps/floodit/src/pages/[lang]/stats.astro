---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameStatsDashboard } from '@arcade/lib-ui/components/GameStatsDashboard';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentFloodIt = resources[currentLanguage]?.floodit ?? resources.en.floodit;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentCommon.stats.title}
	description={`${currentFloodIt.title} - ${currentCommon.stats.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentFloodIt.title, href: `/floodit/${currentLanguage}/` },
		{ label: currentCommon.stats.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentFloodIt.lobby.play,
		href: `/floodit/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentFloodIt.controls.backToLobby,
		href: `/floodit/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="stats"
>
	<GameStatsDashboard
		client:load
		gameId="floodit"
		lang={currentLanguage}
		hideTitle
		bucketLabels={{
			beginner: currentFloodIt.difficulty.beginner,
			easy: currentFloodIt.difficulty.easy,
			medium: currentFloodIt.difficulty.medium,
			hard: currentFloodIt.difficulty.hard,
		}}
		playHref={`/floodit/${currentLanguage}/game`}
	/>
</GameSubpageTemplate>
