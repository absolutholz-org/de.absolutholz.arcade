---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameStatsDashboard } from '@arcade/lib-ui/components/GameStatsDashboard';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentColorMap = resources[currentLanguage]?.['color-map'] ?? resources.en['color-map'];
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentColorMap.stats.title}
	description={`${currentColorMap.title} ${currentColorMap.stats.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: `${currentCommon.app.shortTitle} ${currentCommon.navigation.home}`, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentColorMap.title, href: `/color-map/${currentLanguage}/` },
		{ label: currentColorMap.stats.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentColorMap.controls.newGame,
		href: `/color-map/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentColorMap.controls.backToLobby,
		href: `/color-map/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="stats"
>
	<GameStatsDashboard
		client:load
		gameId="color-map"
		lang={currentLanguage}
		hideTitle
		showFastestRuns
		hideWinLossMetrics
		bucketLabels={{
			easy: currentColorMap.difficulty.easy,
			medium: currentColorMap.difficulty.medium,
			hard: currentColorMap.difficulty.hard,
			expert: currentColorMap.difficulty.expert,
		}}
		playHref={`/color-map/${currentLanguage}/game`}
	/>
</GameSubpageTemplate>
