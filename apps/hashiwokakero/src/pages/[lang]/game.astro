---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { HashiGame } from '../../components/HashiGame';
import HashiBaseLayout from '../../layouts/HashiBaseLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentHashi = resources[lang as SupportedLanguageCode]?.hashiwokakero ?? resources.en.hashiwokakero;
---

<HashiBaseLayout
	title={`${currentHashi.title} | ${currentHashi.description}`}
	description={currentHashi.description}
	lang={lang as SupportedLanguageCode}
	canonical={`https://arcade.absolutholz.de/hashiwokakero/${lang}/game`}
>
	<HashiGame client:only="react" lang={lang as SupportedLanguageCode} />
</HashiBaseLayout>
