---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { QUEENS_MEDAL_DEFINITIONS } from '@arcade/lib-medals';
import { QueensMedalGrid } from '../../components/QueensMedalGrid';
import type { QueensMedalDefinitionItem } from '../../components/QueensMedalGrid/QueensMedalGrid.types';
import QueensStaticPageLayout from '../../layouts/QueensStaticPageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentQueens = resources[currentLanguage]?.queens ?? resources.en.queens;
const currentMedals = resources[currentLanguage]?.medals ?? resources.en.medals;

// Build-time static definitions for Queens medals
const staticMedals: QueensMedalDefinitionItem[] = QUEENS_MEDAL_DEFINITIONS.map((def) => {
	const key = def.id.replace('queens_', '') as keyof typeof currentMedals.queens;
	const localized = currentMedals.queens[key];
	let target: number | undefined;
	if (def.thresholds) {
		target = def.thresholds.gold;
	} else if (
		def.id === 'queens_royal_placement' ||
		def.id === 'queens_college_try' ||
		def.id === 'queens_civil_war'
	) {
		target = 1;
	} else if (def.id === 'queens_royal_indecision') {
		target = 4;
	}

	return {
		id: def.id,
		type: def.type ?? 'standalone',
		tier: def.tier,
		title: localized?.title ?? def.id,
		description: localized?.desc ?? '',
		icon: def.icon,
		target,
		thresholds: def.thresholds,
	};
});
---

<QueensStaticPageLayout
	title={currentMedals.showcase.title}
	description={`${currentQueens.title} - ${currentMedals.showcase.description}`}
	lang={currentLanguage}
	currentSlug="medals"
>
	<QueensMedalGrid client:load lang={currentLanguage} staticMedals={staticMedals} />
</QueensStaticPageLayout>
