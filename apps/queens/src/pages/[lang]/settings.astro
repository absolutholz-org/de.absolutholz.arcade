---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameSettingsPanel } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';
import { QUEENS_SETTINGS_CONFIG } from '../../config/settings';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentQueens = resources[currentLanguage]?.queens ?? resources.en.queens;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentQueens.settings.title}
	subtitle={`${currentQueens.title} — ${currentQueens.settings.title}`}
	description={`${currentQueens.title} - ${currentQueens.settings.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentQueens.title, href: `/queens/${currentLanguage}/` },
		{ label: currentQueens.settings.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentQueens.controls.play,
		href: `/queens/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentQueens.controls.backToLobby,
		href: `/queens/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="settings"
>
	<GameSettingsPanel
		client:load
		config={QUEENS_SETTINGS_CONFIG}
		lang={currentLanguage}
		mode="detailed"
	/>
</GameSubpageTemplate>
