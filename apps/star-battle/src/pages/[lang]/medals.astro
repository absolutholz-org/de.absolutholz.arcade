---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameMedalGrid } from '@arcade/lib-ui/components/GameMedalGrid';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';
import { STAR_BATTLE_MEDAL_DEFINITIONS } from '../../config/medals';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentStarBattle = resources[currentLanguage]?.['star-battle'] ?? resources.en['star-battle'];
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
const currentMedals = resources[currentLanguage]?.medals ?? resources.en.medals;
---

<GameSubpageTemplate
	title={currentMedals.showcase.title}
	description={`${currentStarBattle.title} - ${currentMedals.showcase.description}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentStarBattle.title, href: `/star-battle/${currentLanguage}/` },
		{ label: currentMedals.showcase.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentStarBattle.controls.play,
		href: `/star-battle/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentStarBattle.controls.backToLobby,
		href: `/star-battle/${currentLanguage}/`,
	}}
	containerWidth="wide"
	currentSlug="medals"
>
	<GameMedalGrid
		client:load
		gameId="star-battle"
		definitions={STAR_BATTLE_MEDAL_DEFINITIONS}
		lang={currentLanguage}
		hideActions
	/>
</GameSubpageTemplate>
