---
import { resources } from '@arcade/lib-i18n/config/i18n';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { HeaderUserMenu } from '@arcade/lib-ui';
import PageLayout from '@arcade/lib-ui/layouts/PageLayout/PageLayout.astro';

interface Props {
	title: string;
	description?: string;
	lang: SupportedLanguageCode;
	currentSlug?: string;
	headerVariant?: 'standard' | 'minimal' | 'none';
}

const { title, description, lang, currentSlug = '', headerVariant = 'standard' } = Astro.props;

const currentTranslations = resources[lang]?.common ?? resources.en.common;
---

<PageLayout
	lang={lang}
	title={title}
	description={description || currentTranslations.app.tagline}
	appTitle={currentTranslations.app.title}
	appHomeHref={`/${lang}/`}
	currentSlug={currentSlug}
	headerVariant={headerVariant}
	manifestHref="/site.webmanifest?v=20261006"
>
	<slot name="head" slot="head" />
	<slot name="header-actions" slot="header-actions">
		<HeaderUserMenu client:load lang={lang} />
	</slot>
	<slot name="breadcrumb" slot="breadcrumb" />
	<slot />
</PageLayout>
