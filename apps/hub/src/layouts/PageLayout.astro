---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';

interface Props {
	title: string;
	description?: string;
	lang: SupportedLanguageCode;
	currentSlug?: string;
}

const { title, description, lang, currentSlug = '' } = Astro.props;

const currentTranslations = resources[lang]?.common ?? resources.en.common;
const siteTitle = currentTranslations.app.title;
const pageTitle = currentSlug ? `${title} | ${siteTitle}` : siteTitle;
const pageDescription = description || currentTranslations.app.tagline;

const alternateUrls = SUPPORTED_LANGUAGES.map((item) => ({
	code: item.code,
	label: item.label,
	flag: item.flag,
	href: currentSlug ? `/${item.code}/${currentSlug}` : `/${item.code}/`,
}));

const isGermanOrEnglish = lang === 'en' || lang === 'de';

const legalLinks = [
	{
		href: isGermanOrEnglish ? `/${lang}/privacy` : '/en/privacy',
		hrefLang: isGermanOrEnglish ? lang : 'en',
		label: isGermanOrEnglish
			? currentTranslations.navigation.privacy
			: `${currentTranslations.navigation.privacy} (EN)`,
	},
	{
		href: isGermanOrEnglish ? `/${lang}/imprint` : '/en/imprint',
		hrefLang: isGermanOrEnglish ? lang : 'en',
		label: isGermanOrEnglish
			? currentTranslations.navigation.imprint
			: `${currentTranslations.navigation.imprint} (EN)`,
	},
	{
		href: `/${lang}/accessibility`,
		hrefLang: lang,
		label: currentTranslations.navigation.accessibility,
	},
];
---

<!doctype html>
<html lang={lang} dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={`https://arcade.absolutholz.de/${lang}/${currentSlug}`} />

		{/* Alternate language tags for SEO */}
		{alternateUrls.map((alt) => (
			<link rel="alternate" hreflang={alt.code} href={`https://arcade.absolutholz.de${alt.href}`} />
		))}
		<link rel="alternate" hreflang="x-default" href={`https://arcade.absolutholz.de/en/${currentSlug}`} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">{currentTranslations.navigation.skipToContent}</a>

		<header class="site-header">
			<div class="header-container">
				<a href={`/${lang}/`} class="site-branding" aria-label={siteTitle}>
					<span class="logo-icon" aria-hidden="true">🕹️</span>
					<span class="logo-text">{siteTitle}</span>
				</a>

				<nav aria-label={currentTranslations.language.select} class="language-nav">
					<ul role="list" class="language-list">
						{alternateUrls.map((alt) => (
							<li>
								<a
									href={alt.href}
									hreflang={alt.code}
									aria-current={alt.code === lang ? 'page' : undefined}
									class:list={['lang-link', { active: alt.code === lang }]}
									data-lang-code={alt.code}
								>
									<span class="lang-flag" aria-hidden="true">{alt.flag}</span>
									<span class="lang-label">{alt.label}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main id="main-content" class="site-main">
			<article class="page-container prose">
				<slot />
			</article>
		</main>

		<footer class="site-footer">
			<div class="footer-container">
				<nav aria-label={currentTranslations.navigation.legal} class="footer-legal">
					<ul role="list">
						{legalLinks.map((link) => (
							<li>
								<a href={link.href} hreflang={link.hrefLang}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>

				<div class="footer-identity">
					<span class="copyright">© {new Date().getFullYear()} absolutholz</span>
					<span class="version">v0.1.0</span>
				</div>

				<div class="footer-tagline">
					<span>{currentTranslations.app.tagline}</span>
				</div>
			</div>
		</footer>

		<script is:inline>
			// Persist language to localStorage upon explicit selection
			document.querySelectorAll('.lang-link').forEach((link) => {
				link.addEventListener('click', (event) => {
					const code = link.getAttribute('data-lang-code');
					if (code) {
						try {
							localStorage.setItem('arcade::i18n::language', code);
						} catch (_) {}
					}
				});
			});
		</script>

		<style>
			:root {
				--color-surface: light-dark(oklch(0.98 0.005 250), oklch(0.12 0.015 250));
				--color-container-1: light-dark(oklch(0.95 0.01 250), oklch(0.18 0.02 250));
				--color-container-2: light-dark(oklch(0.9 0.015 250), oklch(0.24 0.02 250));
				--color-text-1: light-dark(oklch(0.2 0.01 250), oklch(0.95 0.005 250));
				--color-text-2: light-dark(oklch(0.4 0.01 250), oklch(0.8 0.01 250));
				--color-accent: light-dark(oklch(0.6 0.18 250), oklch(0.7 0.16 250));
				--radius-sm: 0.25rem;
				--radius-md: 0.5rem;
				color-scheme: light dark;
			}

			* {
				box-sizing: border-box;
				margin: 0;
			}

			body {
				background-color: var(--color-surface);
				color: var(--color-text-1);
				display: flex;
				flex-direction: column;
				font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				line-height: 1.6;
				min-height: 100vh;
			}

			.skip-link {
				background: var(--color-accent);
				border-radius: var(--radius-sm);
				color: #fff;
				left: 1rem;
				padding: 0.5rem 1rem;
				position: absolute;
				top: -3rem;
				transition: top 150ms ease;
				z-index: 100;
			}

			.skip-link:focus {
				top: 1rem;
			}

			.site-header {
				border-bottom: 1px solid var(--color-container-2);
				padding: 0.75rem 1.5rem;
				width: 100%;
			}

			.header-container {
				align-items: center;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				justify-content: space-between;
				margin: 0 auto;
				max-width: 64rem;
			}

			.site-branding {
				align-items: center;
				color: var(--color-text-1);
				display: inline-flex;
				font-size: 1.25rem;
				font-weight: 700;
				gap: 0.5rem;
				text-decoration: none;
			}

			.language-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.375rem;
				list-style: none;
				padding: 0;
			}

			.lang-link {
				align-items: center;
				border-radius: var(--radius-sm);
				color: var(--color-text-2);
				display: inline-flex;
				font-size: 0.875rem;
				gap: 0.25rem;
				min-height: 1.75rem;
				padding: 0.25rem 0.5rem;
				text-decoration: none;
				transition: background 150ms ease, color 150ms ease;
			}

			.lang-link:hover {
				background: var(--color-container-1);
				color: var(--color-text-1);
			}

			.lang-link.active {
				background: var(--color-container-2);
				color: var(--color-text-1);
				font-weight: 600;
			}

			.site-main {
				flex: 1;
				padding: 2.5rem 1.5rem;
				width: 100%;
			}

			.page-container {
				margin: 0 auto;
				max-width: 48rem;
			}

			.prose :global(h1) {
				font-size: 2.25rem;
				line-height: 1.2;
				margin-bottom: 1.5rem;
			}

			.prose :global(h2) {
				border-bottom: 1px solid var(--color-container-2);
				font-size: 1.5rem;
				margin-bottom: 0.75rem;
				margin-top: 2rem;
				padding-bottom: 0.5rem;
			}

			.prose :global(h3) {
				font-size: 1.125rem;
				margin-bottom: 0.5rem;
				margin-top: 1.25rem;
			}

			.prose :global(p) {
				margin-bottom: 1rem;
			}

			.prose :global(ul) {
				margin-bottom: 1.25rem;
				padding-left: 1.5rem;
			}

			.prose :global(li) {
				margin-bottom: 0.375rem;
			}

			.prose :global(a) {
				color: var(--color-accent);
			}

			.site-footer {
				border-top: 1px solid var(--color-container-2);
				color: var(--color-text-2);
				font-size: 0.875rem;
				padding: 1.5rem;
			}

			.footer-container {
				align-items: center;
				display: flex;
				flex-direction: column;
				gap: 1rem;
				margin: 0 auto;
				max-width: 64rem;
				text-align: center;
			}

			@media (min-width: 48rem) {
				.footer-container {
					display: grid;
					grid-template-columns: 1fr auto 1fr;
					text-align: left;
				}

				.footer-identity {
					justify-self: center;
				}

				.footer-tagline {
					justify-self: end;
				}
			}

			.footer-legal ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				list-style: none;
				padding: 0;
			}

			.footer-legal a {
				color: var(--color-text-2);
				text-decoration: none;
			}

			.footer-legal a:hover {
				color: var(--color-accent);
				text-decoration: underline;
			}

			.footer-identity {
				display: flex;
				gap: 0.5rem;
			}
		</style>
	</body>
</html>
