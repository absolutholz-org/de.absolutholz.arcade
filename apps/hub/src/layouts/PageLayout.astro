---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { Logo } from '@arcade/lib-ui/components/Logo';
import { SiteFooter } from '@arcade/lib-ui/components/SiteFooter';
import { SiteHeader } from '@arcade/lib-ui/components/SiteHeader';
import { HeaderActions } from '../components/HeaderActions';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	lang: SupportedLanguageCode;
	currentSlug?: string;
}

const { title, description, lang, currentSlug = '' } = Astro.props;

const currentTranslations = resources[lang]?.common ?? resources.en.common;
const siteTitle = currentTranslations.app.title;
const pageTitle = currentSlug ? `${title} | ${siteTitle}` : siteTitle;
const pageDescription = description || currentTranslations.app.tagline;

const alternateUrls = SUPPORTED_LANGUAGES.map((item) => ({
	code: item.code,
	label: item.label,
	flag: item.flag,
	href: currentSlug ? `/${item.code}/${currentSlug}` : `/${item.code}/`,
}));

const isGermanOrEnglish = lang === 'en' || lang === 'de';

const legalLinks = [
	{
		href: isGermanOrEnglish ? `/${lang}/privacy` : '/en/privacy',
		hrefLang: isGermanOrEnglish ? lang : 'en',
		label: isGermanOrEnglish
			? currentTranslations.navigation.privacy
			: `${currentTranslations.navigation.privacy} (EN)`,
	},
	{
		href: isGermanOrEnglish ? `/${lang}/imprint` : '/en/imprint',
		hrefLang: isGermanOrEnglish ? lang : 'en',
		label: isGermanOrEnglish
			? currentTranslations.navigation.imprint
			: `${currentTranslations.navigation.imprint} (EN)`,
	},
	{
		href: `/${lang}/accessibility`,
		hrefLang: lang,
		label: currentTranslations.navigation.accessibility,
	},
];

const resourceLinks = [
	{
		external: true,
		href: 'https://github.com/absolutholz-org/de.absolutholz.arcade',
		label: 'GitHub',
	},
	{
		external: true,
		href: '/storybook',
		label: 'Storybook',
	},
];
---

<BaseLayout
	lang={lang}
	dir="ltr"
	title={pageTitle}
	description={pageDescription}
	canonical={`https://arcade.absolutholz.de/${lang}/${currentSlug}`}
>
	<Fragment slot="head">
		{/* Alternate language tags for SEO */}
		{alternateUrls.map((alt) => (
			<link rel="alternate" hreflang={alt.code} href={`https://arcade.absolutholz.de${alt.href}`} />
		))}
		<link rel="alternate" hreflang="x-default" href={`https://arcade.absolutholz.de/en/${currentSlug}`} />
	</Fragment>
		<a href="#main-content" class="skip-link">{currentTranslations.navigation.skipToContent}</a>

		<SiteHeader>
			<div class="header-container">
				<a href={`/${lang}/`} class="site-branding" aria-label={siteTitle}>
					<Logo size="sm" />
					<span class="logo-text">{siteTitle}</span>
				</a>

				<HeaderActions client:load lang={lang} currentSlug={currentSlug} />
			</div>
		</SiteHeader>

		<main id="main-content" class="site-main">
			<article class="page-container prose">
				<slot />
			</article>
		</main>

		<SiteFooter
			legalAriaLabel={currentTranslations.navigation.legal}
			legalLinks={legalLinks}
			copyright={{
				startYear: 2024,
				currentYear: new Date().getFullYear(),
				owner: 'absolutholz',
			}}
			version="0.1.0"
			resourceLinks={resourceLinks}
		/>

		<style>
			body {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
			}

			.skip-link {
				background: var(--color-accent);
				border-radius: var(--radius-sm);
				color: #fff;
				left: 1rem;
				padding: 0.5rem 1rem;
				position: absolute;
				top: -3rem;
				transition: top 150ms ease;
				z-index: 100;
			}

			.skip-link:focus {
				top: 1rem;
			}

			.header-container {
				align-items: center;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				justify-content: space-between;
				margin: 0 auto;
				max-width: 64rem;
				width: 100%;
			}

			.site-branding {
				align-items: center;
				color: var(--color-text-1);
				display: inline-flex;
				font-size: 1.25rem;
				font-weight: 700;
				gap: 0.75rem;
				text-decoration: none;
			}

			.site-main {
				flex: 1;
				padding: 2.5rem 1.5rem;
				width: 100%;
			}

			.page-container {
				margin: 0 auto;
				max-width: 48rem;
			}

			.prose :global(h1) {
				font-size: 2.25rem;
				line-height: 1.2;
				margin-bottom: 1.5rem;
			}

			.prose :global(h2) {
				border-bottom: 1px solid var(--color-container-2);
				font-size: 1.5rem;
				margin-bottom: 0.75rem;
				margin-top: 2rem;
				padding-bottom: 0.5rem;
			}

			.prose :global(h3) {
				font-size: 1.125rem;
				margin-bottom: 0.5rem;
				margin-top: 1.25rem;
			}

			.prose :global(p) {
				margin-bottom: 1rem;
			}

			.prose :global(ul) {
				margin-bottom: 1.25rem;
				padding-left: 1.5rem;
			}

			.prose :global(li) {
				margin-bottom: 0.375rem;
			}

			.prose :global(a) {
				color: var(--color-accent);
			}
		</style>
</BaseLayout>
