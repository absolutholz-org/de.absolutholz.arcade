---
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';

const defaultLang = DEFAULT_LANGUAGE;
const targetPath = '/tools/dice';
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	lang={defaultLang}
	titleOptions={{
		subject: 'Dice Roller',
	}}
	description="Tabletop companion dice roller for board games."
>
	<Fragment slot="head">
		<meta http-equiv="refresh" content={`0;url=/${defaultLang}${targetPath}`} />
		<script is:inline define:vars={{ supportedCodes: SUPPORTED_LANGUAGES.map((l) => l.code), defaultLang, targetPath }}>
			(function () {
				function redirect(lang) {
					try {
						document.cookie = 'arcade_lang=' + lang + '; path=/; max-age=31536000; SameSite=Lax';
					} catch (_) {}
					window.location.replace('/' + lang + targetPath);
				}

				try {
					var stored = localStorage.getItem('arcade::i18n::language');
					if (stored && supportedCodes.indexOf(stored) !== -1) {
						redirect(stored);
						return;
					}
				} catch (_) {}

				var candidates = navigator.languages || [navigator.language || ''];
				for (var i = 0; i < candidates.length; i++) {
					var candidate = (candidates[i] || '').toLowerCase().split('-')[0];
					if (supportedCodes.indexOf(candidate) !== -1) {
						redirect(candidate);
						return;
					}
				}

				redirect(defaultLang);
			})();
		</script>
	</Fragment>
</BaseLayoutWithSiteHeaderAndSiteFooter>
