---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { HeaderUserMenu } from '@arcade/lib-ui';
import { Hero } from '@arcade/lib-ui/components/Hero';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import StaticPageLayout from '@arcade/lib-ui/layouts/StaticPageLayout/StaticPageLayout.astro';
import { MedalsShowcase } from '../../components/MedalsShowcase/MedalsShowcase';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentMedals = resources[lang as SupportedLanguageCode]?.medals ?? resources.en.medals;
---

<StaticPageLayout
	title={currentMedals.showcase.title}
	description={currentMedals.showcase.description}
	lang={lang as SupportedLanguageCode}
	currentSlug="medals"
>
	<HeaderUserMenu slot="header-actions" client:load lang={lang as SupportedLanguageCode} />
	<PageContainer>
		<Hero
			title={currentMedals.showcase.title}
			tagline={currentMedals.showcase.description}
			align="left"
		/>
		<MedalsShowcase client:load lang={lang as SupportedLanguageCode} />
	</PageContainer>
</StaticPageLayout>
