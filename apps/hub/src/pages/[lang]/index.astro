---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { Hero } from '@arcade/lib-ui/components/Hero';
import { Logo } from '@arcade/lib-ui/components/Logo';
import PageLayout from '../../layouts/PageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentTranslations = resources[lang as SupportedLanguageCode]?.common ?? resources.en.common;
const currentSudoku = resources[lang as SupportedLanguageCode]?.sudoku ?? resources.en.sudoku;
const currentMinesweeper = resources[lang as SupportedLanguageCode]?.minesweeper ?? resources.en.minesweeper;
---

<PageLayout
	title={currentTranslations.app.title}
	description={currentTranslations.app.tagline}
	lang={lang as SupportedLanguageCode}
	currentSlug=""
	headerVariant="minimal"
>
	<Hero
		title={currentTranslations.app.title}
		tagline={currentTranslations.app.tagline}
		logo={<Logo size="xl" />}
		align="left"
	/>

	<section class="games-section">
		<h2>{currentTranslations.hub.gamesTitle}</h2>
		<div class="games-grid">
			<a href={`/sudoku/${lang}/`} class="game-card">
				<h3>{currentSudoku.title}</h3>
				<p>{currentSudoku.description}</p>
			</a>
			<a href={`/minesweeper/${lang}/`} class="game-card">
				<h3>{currentMinesweeper.title}</h3>
				<p>{currentMinesweeper.description}</p>
			</a>
		</div>
	</section>

</PageLayout>

<style>

	.games-section {
		margin-top: 2rem;
	}

	.games-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		margin-top: 1rem;
	}

	.game-card {
		background: var(--color-container-1);
		border: 1px solid var(--color-container-2);
		border-radius: var(--radius-md);
		color: var(--color-text-1);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		text-decoration: none;
		transition: border-color 150ms ease, transform 150ms ease;
	}

	.game-card:hover {
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}

	.game-card h3 {
		font-size: 1.25rem;
		margin: 0;
	}

	.game-card p {
		color: var(--color-text-2);
		font-size: 0.875rem;
		line-height: 1.5;
		margin: 0;
	}
</style>
