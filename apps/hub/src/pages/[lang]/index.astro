---
import { ALL_GAMES } from '@arcade/lib-games';
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { Hero } from '@arcade/lib-ui/components/Hero';
import { Logo } from '@arcade/lib-ui/components/Logo';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import { UserMedalSummaryWidget } from '../../components/UserMedalSummaryWidget';
import PageLayout from '../../layouts/PageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentTranslations = resources[lang as SupportedLanguageCode]?.common ?? resources.en.common;
---

<PageLayout
	title={currentTranslations.app.title}
	description={currentTranslations.app.tagline}
	lang={lang as SupportedLanguageCode}
	currentSlug=""
	headerVariant="minimal"
>
	<PageContainer>
		<Hero title={currentTranslations.app.title} tagline={currentTranslations.app.tagline} align="left">
			<Logo size="xl" slot="logo" />
		</Hero>

		<UserMedalSummaryWidget client:idle lang={lang as SupportedLanguageCode} />

		<section class="games-section">
			<h2>{currentTranslations.hub.gamesTitle}</h2>
			<div class="games-grid">
				{ALL_GAMES.map((game) => {
					const gameTranslation =
						resources[lang as SupportedLanguageCode]?.[game.i18nNamespace] ??
						resources.en[game.i18nNamespace];
					return (
						<a href={`${game.route}/${lang}/`} class="game-card">
							<div class="game-card-header">
								<span class="game-card-icon" aria-hidden="true">{game.assets.icon}</span>
								<h3>{gameTranslation?.title ?? game.name}</h3>
							</div>
							<p>{gameTranslation?.description}</p>
						</a>
					);
				})}
			</div>
		</section>
	</PageContainer>
</PageLayout>

<style>
	.games-section {
		margin-top: 2rem;
	}

	.games-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
		margin-top: 1rem;
	}

	.game-card {
		background: var(--color-container-1);
		border: 1px solid var(--color-container-2);
		border-radius: var(--radius-md);
		color: var(--color-text-1);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		text-decoration: none;
		transition:
			border-color 150ms ease,
			transform 150ms ease;
	}

	.game-card:hover,
	.game-card:focus,
	.game-card:focus-visible,
	.game-card:visited,
	.game-card:active {
		text-decoration: none;
	}

	.game-card *,
	.game-card *::before,
	.game-card *::after {
		text-decoration: none;
	}

	.game-card:hover {
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}

	.game-card-header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.game-card-icon {
		font-size: 1.75rem;
		line-height: 1;
	}

	.game-card h3 {
		font-size: 1.25rem;
		margin: 0;
	}

	.game-card p {
		color: var(--color-text-2);
		font-size: 0.875rem;
	}
</style>
