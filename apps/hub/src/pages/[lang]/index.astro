---
import { ALL_GAMES, ALL_TOOLS } from '@arcade/lib-games';
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { getGameDescription, getGameTitle } from '@arcade/lib-i18n/utils/gameTitle';
import { getCategoryLabel } from '@arcade/lib-i18n/utils/taxonomy';
import { GameCard } from '@arcade/lib-ui/components/GameCard';
import { GamesGrid } from '@arcade/lib-ui/components/GamesGrid';
import { Hero } from '@arcade/lib-ui/components/Hero';
import { Logo } from '@arcade/lib-ui/components/Logo';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import { Text } from '@arcade/lib-ui/components/Text';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import { UserMedalSummaryWidget } from '../../components/UserMedalSummaryWidget';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentTranslations = resources[lang as SupportedLanguageCode]?.common ?? resources.en.common;
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	titleOptions={{}}
	description={currentTranslations.app.tagline}
	lang={lang as SupportedLanguageCode}
	hideBrand={true}
	hasBorder={false}
>
	<PageContainer>
		<Hero title={currentTranslations.app.title} tagline={currentTranslations.app.tagline}>
			<Logo size="xl" slot="logo" />
		</Hero>

		<UserMedalSummaryWidget client:idle lang={lang as SupportedLanguageCode} />

		<section class="games-section">
			<Text as="h2" variant="h2">{currentTranslations.hub.gamesTitle}</Text>
			<GamesGrid>
				{ALL_GAMES.map((game) => (
					<GameCard
						href={`${game.route}/${lang}/`}
						title={getGameTitle(game.id, lang as SupportedLanguageCode)}
						description={getGameDescription(game.id, lang as SupportedLanguageCode)}
						icon={game.assets.icon}
						badge={getCategoryLabel(game.category.primary, lang as SupportedLanguageCode)}
					/>
				))}
			</GamesGrid>
		</section>

		<section class="tools-section">
			<Text as="h2" variant="h2">{currentTranslations.hub.toolsTitle}</Text>
			<GamesGrid>
				{ALL_TOOLS.map((tool) => {
					const toolTranslation = currentTranslations.tools?.[tool.id];
					return (
						<GameCard
							href={`/${lang}${tool.route}`}
							title={toolTranslation?.title ?? tool.name}
							description={toolTranslation?.description}
							icon={tool.assets.icon}
						/>
					);
				})}
			</GamesGrid>
		</section>
	</PageContainer>
</BaseLayoutWithSiteHeaderAndSiteFooter>

<style>
	.games-section,
	.tools-section {
		margin-top: 2rem;
	}
</style>
