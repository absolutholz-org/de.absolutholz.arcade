---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { HeaderUserMenu } from '@arcade/lib-ui';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import { ThemeSelector } from '@arcade/lib-ui/components/ThemeSelector';
import StaticPageLayout from '@arcade/lib-ui/layouts/StaticPageLayout/StaticPageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentTranslations = resources[lang as SupportedLanguageCode]?.common ?? resources.en.common;
---

<StaticPageLayout
	title={currentTranslations.settings.title}
	description={currentTranslations.settings.description}
	lang={lang as SupportedLanguageCode}
	currentSlug="settings"
>
	<HeaderUserMenu slot="header-actions" client:load lang={lang as SupportedLanguageCode} />
	<div class="settings-page">
		<header class="settings-header">
			<h1>{currentTranslations.settings.title}</h1>
			<p class="settings-tagline">{currentTranslations.settings.description}</p>
		</header>

		<section class="settings-content">
			<ThemeSelector client:load lang={lang as SupportedLanguageCode} />
		</section>

		<section class="settings-content offline-section">
			<div class="offline-setting-row">
				<div class="offline-setting-text">
					<h2>{currentTranslations.offline.title}</h2>
					<p class="settings-tagline">{currentTranslations.offline.description}</p>
				</div>
				<a href={`/${lang}/offline`} class="offline-link">
					{currentTranslations.offline.title} →
				</a>
			</div>
		</section>
	</div>
</StaticPageLayout>

<style>
	.settings-page {
		margin: 0 auto;
		max-width: 48rem;
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.settings-header {
		margin-bottom: 0.5rem;
	}

	.settings-header h1 {
		font-size: 2.25rem;
		font-weight: 800;
		line-height: 1.2;
		margin-bottom: 0.5rem;
	}

	.settings-tagline {
		color: var(--color-text-2);
		font-size: 1.125rem;
	}

	.settings-content {
		background: var(--color-container-1);
		border: 1px solid var(--color-container-2);
		border-radius: var(--radius-md);
		padding: 1.5rem;
	}

	.offline-section {
		margin-top: 0.5rem;
	}

	.offline-setting-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.offline-setting-text h2 {
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 0.25rem;
	}

	.offline-setting-text p {
		font-size: 0.95rem;
	}

	.offline-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-weight: 600;
		color: var(--color-action-primary, #2563eb);
		text-decoration: none;
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-container-3, #d1d5db);
		border-radius: var(--radius-sm);
		background: var(--color-container-2);
		transition: all 0.2s ease;
	}

	.offline-link:hover {
		background: var(--color-container-3);
	}
</style>
