---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { HeaderUserMenu, PrivacySettingRow } from '@arcade/lib-ui';
import { Button } from '@arcade/lib-ui/components/Button';
import { Hero } from '@arcade/lib-ui/components/Hero';
import { LanguageSelector } from '@arcade/lib-ui/components/LanguageSelector';
import { SchemeSelector } from '@arcade/lib-ui/components/SchemeSelector';
import { Stack } from '@arcade/lib-ui/components/Stack';
import { ThemeSelector } from '@arcade/lib-ui/components/ThemeSelector';
import StaticPageLayout from '@arcade/lib-ui/layouts/StaticPageLayout/StaticPageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentTranslations = resources[lang as SupportedLanguageCode]?.common ?? resources.en.common;
---

<StaticPageLayout
	title={currentTranslations.settings.title}
	description={currentTranslations.settings.description}
	lang={lang as SupportedLanguageCode}
	currentSlug="settings"
>
	<HeaderUserMenu slot="header-actions" client:load lang={lang as SupportedLanguageCode} />
	<Stack spacing="xl">
		<Hero
			title={currentTranslations.settings.title}
			tagline={currentTranslations.settings.description}
			align="left"
		/>

		<section class="settings-content">
			<LanguageSelector client:load lang={lang as SupportedLanguageCode} />
		</section>

		<section class="settings-content">
			<SchemeSelector client:load lang={lang as SupportedLanguageCode} />
		</section>

		<section class="settings-content">
			<ThemeSelector client:load lang={lang as SupportedLanguageCode} />
		</section>

		<section class="settings-content">
			<PrivacySettingRow client:load />
		</section>

		<section class="settings-content">
			<div class="offline-setting-row">
				<div>
					<h2>{currentTranslations.offline.title}</h2>
					<p class="offline-tagline">{currentTranslations.offline.description}</p>
				</div>
				<Button as="a" href={`/${lang}/offline`} variant="outline" size="md">
					{currentTranslations.offline.title} →
				</Button>
			</div>
		</section>
	</Stack>
</StaticPageLayout>

<style>
	.settings-content {
		background: var(--color-container-1);
		border: 1px solid var(--color-container-2);
		border-radius: var(--radius-md);
		padding: 1.5rem;
	}

	.offline-setting-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.offline-setting-row h2 {
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 0.25rem;
	}

	.offline-tagline {
		color: var(--color-text-2);
		font-size: 0.95rem;
	}
</style>
