---
import { getEntry } from 'astro:content';
import { resources } from '@arcade/lib-i18n/config/i18n';
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { Button } from '@arcade/lib-ui/components/Button';
import MarkdownPageTemplate from '@arcade/lib-ui/templates/MarkdownPageTemplate/MarkdownPageTemplate.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const entry = (await getEntry('pages', `${lang}/rules`)) ?? (await getEntry('pages', `${DEFAULT_LANGUAGE}/rules`));
const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;

const currentUndead = resources[currentLanguage]?.undead ?? resources.en.undead;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<MarkdownPageTemplate
	title={entry?.data.title ?? currentUndead.title}
	description={entry?.data.description}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: `${currentCommon.app.shortTitle} ${currentCommon.navigation.home}`, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentUndead.title, href: `/undead/${currentLanguage}/` },
		{ label: entry?.data.title ?? currentCommon.navigation.rules, isCurrent: true },
	]}
	currentSlug="rules"
>
	{Content && <Content />}

	<Button slot="action" as="a" href={`/undead/${currentLanguage}/game`} variant="primary" size="lg">
		{currentUndead.controls.newGame}
	</Button>
</MarkdownPageTemplate>
