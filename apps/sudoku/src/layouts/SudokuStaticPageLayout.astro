---
import { resources } from '@arcade/lib-i18n/config/i18n';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { HeaderUserMenu } from '@arcade/lib-ui';
import type { PageContainerVariant } from '@arcade/lib-ui/components/PageContainer';
import StaticPageLayout from '@arcade/lib-ui/layouts/StaticPageLayout/StaticPageLayout.astro';

interface Props {
	title: string;
	description?: string;
	lang: SupportedLanguageCode;
	currentSlug?: string;
	containerVariant?: PageContainerVariant;
}

const { title, description, lang, currentSlug = '', containerVariant } = Astro.props;

const currentSudoku = resources[lang]?.sudoku ?? resources.en.sudoku;
---

<StaticPageLayout
	lang={lang}
	title={title}
	description={description || currentSudoku.description}
	appTitle={currentSudoku.title}
	appHomeHref={`/sudoku/${lang}/`}
	basePath="sudoku"
	currentSlug={currentSlug}
	containerVariant={containerVariant}
>
	<slot name="head" slot="head" />
	<slot name="header-actions" slot="header-actions">
		<HeaderUserMenu client:load lang={lang} />
	</slot>
	<slot />
</StaticPageLayout>
