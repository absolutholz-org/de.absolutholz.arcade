---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import { LanguageRedirectFallback } from '@arcade/lib-ui/components/LanguageRedirectFallback';
import SudokuBaseLayout from '../layouts/SudokuBaseLayout.astro';

const currentCommon = resources[DEFAULT_LANGUAGE].common;
const currentSudoku = resources[DEFAULT_LANGUAGE].sudoku;
const languageItems = SUPPORTED_LANGUAGES.map((item) => ({
	code: item.code,
	label: item.label,
	flag: item.flag,
	href: `/sudoku/${item.code}/`,
}));
---

<SudokuBaseLayout
	lang={DEFAULT_LANGUAGE}
	title={currentSudoku.title}
	canonical="https://arcade.absolutholz.de/sudoku/en/"
>
	<Fragment slot="head">
		{/* Non-JS fallback redirect to default English */}
		<meta http-equiv="refresh" content="0;url=/sudoku/en/" />

		<script is:inline define:vars={{ supportedCodes: SUPPORTED_LANGUAGES.map((l) => l.code), defaultLang: DEFAULT_LANGUAGE }}>
			(function () {
				try {
					var stored = localStorage.getItem('arcade::i18n::language');
					if (stored && supportedCodes.indexOf(stored) !== -1) {
						window.location.replace('/sudoku/' + stored + '/');
						return;
					}
				} catch (_) {}

				var candidates = navigator.languages || [navigator.language || ''];
				for (var i = 0; i < candidates.length; i++) {
					var candidate = (candidates[i] || '').toLowerCase().split('-')[0];
					if (supportedCodes.indexOf(candidate) !== -1) {
						window.location.replace('/sudoku/' + candidate + '/');
						return;
					}
				}

				window.location.replace('/sudoku/' + defaultLang + '/');
			})();
		</script>
	</Fragment>

	<LanguageRedirectFallback
		title={currentSudoku.title}
		message={currentCommon.app.redirectNotice}
		languagesAriaLabel={currentCommon.switchers.language.ariaLabel}
		languages={languageItems}
	/>
</SudokuBaseLayout>
