---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { Button } from '@arcade/lib-ui/components/Button';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import SudokuPageLayout from '../../layouts/SudokuPageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentSudoku = resources[lang as SupportedLanguageCode]?.sudoku ?? resources.en.sudoku;
---

<SudokuPageLayout
	title={currentSudoku.rules.title}
	description={currentSudoku.rules.objective}
	lang={lang as SupportedLanguageCode}
	currentSlug="rules"
>
	<PageContainer>
		<div class="rules-page">
			<h1>{currentSudoku.rules.title}</h1>

			<section class="rules-section">
				<h2>{currentSudoku.rules.objectiveTitle}</h2>
				<p>{currentSudoku.rules.objective}</p>
			</section>

			<section class="rules-section">
				<h2>{currentSudoku.rules.rule1Title}</h2>
				<p>{currentSudoku.rules.rule1}</p>
			</section>

			<section class="rules-section">
				<h2>{currentSudoku.rules.rule2Title}</h2>
				<p>{currentSudoku.rules.rule2}</p>
			</section>

			<section class="rules-section">
				<h2>{currentSudoku.rules.rule3Title}</h2>
				<p>{currentSudoku.rules.rule3}</p>
			</section>

			<section class="rules-section tip-box">
				<h2>{currentSudoku.rules.notesTipTitle}</h2>
				<p>{currentSudoku.rules.notesTip}</p>
			</section>

			<div class="rules-actions">
				<Button as="a" href={`/sudoku/${lang}/`} variant="primary" size="md">
					{currentSudoku.controls.newGame}
				</Button>
			</div>
		</div>
	</PageContainer>
</SudokuPageLayout>

<style>
	.rules-page {
		margin: 0 auto;
		max-width: 48rem;
		width: 100%;
	}

	.rules-page h1 {
		font-size: 2.25rem;
		font-weight: 800;
		line-height: 1.2;
		margin-bottom: 1.5rem;
	}

	.rules-section {
		margin-bottom: 2rem;
	}

	.rules-section h2 {
		color: var(--color-text-1);
		font-size: 1.375rem;
		margin-bottom: 0.5rem;
	}

	.rules-section p {
		color: var(--color-text-2);
		line-height: 1.6;
	}

	.tip-box {
		background: var(--color-container-1);
		border-left: 4px solid var(--color-accent);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		padding: 1.25rem;
	}

	.rules-actions {
		display: flex;
		justify-content: center;
		margin-top: 2.5rem;
	}
</style>
