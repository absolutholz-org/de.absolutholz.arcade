---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { SudokuGame } from '../../components/SudokuGame';
import SudokuBaseLayout from '../../layouts/SudokuBaseLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentSudoku = resources[lang as SupportedLanguageCode]?.sudoku ?? resources.en.sudoku;
---

<SudokuBaseLayout
	title={`${currentSudoku.title} | ${currentSudoku.description}`}
	description={currentSudoku.description}
	lang={lang as SupportedLanguageCode}
	canonical={`https://arcade.absolutholz.de/sudoku/${lang}/game`}
>
	<SudokuGame client:only="react" lang={lang as SupportedLanguageCode} />
</SudokuBaseLayout>
