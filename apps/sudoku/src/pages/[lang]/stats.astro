---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameStatsDashboard } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentSudoku = resources[currentLanguage]?.sudoku ?? resources.en.sudoku;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentSudoku.stats.title}
	description={`${currentSudoku.title} ${currentSudoku.stats.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentSudoku.title, href: `/sudoku/${currentLanguage}/` },
		{ label: currentSudoku.stats.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentSudoku.controls.newGame,
		href: `/sudoku/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentSudoku.controls.backToLobby,
		href: `/sudoku/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="stats"
>
	<GameStatsDashboard
		client:load
		gameId="sudoku"
		lang={currentLanguage}
		hideTitle
		bucketLabels={{
			easy: currentSudoku.difficulty.easy,
			medium: currentSudoku.difficulty.medium,
			hard: currentSudoku.difficulty.hard,
			veryHard: currentSudoku.difficulty.veryHard,
			insane: currentSudoku.difficulty.insane,
			inhuman: currentSudoku.difficulty.inhuman,
		}}
		playHref={`/sudoku/${currentLanguage}/game`}
	/>
</GameSubpageTemplate>
