---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { SUDOKU_MEDAL_DEFINITIONS } from '@arcade/lib-medals';
import { SudokuMedalGrid } from '../../components/SudokuMedalGrid';
import type { SudokuMedalDefinitionItem } from '../../components/SudokuMedalGrid/SudokuMedalGrid.types';
import SudokuStaticPageLayout from '../../layouts/SudokuStaticPageLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentSudoku = resources[currentLanguage]?.sudoku ?? resources.en.sudoku;
const currentMedals = resources[currentLanguage]?.medals ?? resources.en.medals;

// Build-time static definitions for Sudoku medals (Bronze, Silver, Gold)
const staticMedals: SudokuMedalDefinitionItem[] = SUDOKU_MEDAL_DEFINITIONS.map((def) => {
	const key = def.id.replace('sudoku_', '') as keyof typeof currentMedals.sudoku;
	const localized = currentMedals.sudoku[key];
	let target: number | undefined;
	if (def.id === 'sudoku_first_win') target = 1;
	else if (def.id === 'sudoku_win_streak_3') target = 3;
	else if (def.id === 'sudoku_expert_master') target = 10;

	return {
		id: def.id,
		tier: def.tier,
		title: localized?.title ?? def.id,
		description: localized?.desc ?? '',
		icon: def.icon,
		target,
	};
});
---

<SudokuStaticPageLayout
	title={currentMedals.showcase.title}
	description={`${currentSudoku.title} - ${currentMedals.showcase.description}`}
	lang={currentLanguage}
	currentSlug="medals"
	containerVariant="standard"
>
	<SudokuMedalGrid client:load lang={currentLanguage} staticMedals={staticMedals} />
</SudokuStaticPageLayout>
