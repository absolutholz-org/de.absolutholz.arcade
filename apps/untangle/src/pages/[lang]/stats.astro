---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameStatsDashboard } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentUntangle = resources[currentLanguage]?.untangle ?? resources.en.untangle;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentCommon.stats.title}
	description={`${currentUntangle.title} - ${currentCommon.stats.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentUntangle.title, href: `/untangle/${currentLanguage}/` },
		{ label: currentCommon.stats.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentUntangle.controls.play,
		href: `/untangle/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentUntangle.controls.backToLobby,
		href: `/untangle/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="stats"
>
	<GameStatsDashboard
		client:load
		gameId="untangle"
		lang={currentLanguage}
		hideTitle
		bucketLabels={{
			easy: currentUntangle.difficulty.easy,
			medium: currentUntangle.difficulty.medium,
			hard: currentUntangle.difficulty.hard,
		}}
		playHref={`/untangle/${currentLanguage}/game`}
	/>
</GameSubpageTemplate>
