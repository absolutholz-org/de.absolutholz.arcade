---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameSettingsPanel } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';
import { TRACKS_SETTINGS_CONFIG } from '../../config/settings';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentTracks = resources[currentLanguage]?.tracks ?? resources.en.tracks;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentTracks.settings.title}
	subtitle={`${currentTracks.title} — ${currentTracks.settings.title}`}
	description={`${currentTracks.title} - ${currentTracks.settings.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentTracks.title, href: `/tracks/${currentLanguage}/` },
		{ label: currentTracks.settings.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentTracks.controls.play,
		href: `/tracks/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentTracks.controls.backToLobby,
		href: `/tracks/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="settings"
>
	<GameSettingsPanel
		client:load
		config={TRACKS_SETTINGS_CONFIG}
		lang={currentLanguage}
		mode="detailed"
	/>
</GameSubpageTemplate>
