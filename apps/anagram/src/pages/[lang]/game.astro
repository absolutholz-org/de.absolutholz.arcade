---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import GameLayout from '@arcade/lib-ui/layouts/GameLayout/GameLayout.astro';
import { AnagramGame } from '../../components/AnagramGame';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentAnagram = resources[lang as SupportedLanguageCode]?.anagram ?? resources.en.anagram;
---

<GameLayout
	title={`${currentAnagram.title} | ${currentAnagram.description}`}
	description={currentAnagram.description}
	lang={lang as SupportedLanguageCode}
	canonical={`https://arcade.absolutholz.de/anagram/${lang}/game`}
	appTitle="Anagram Scramble"
>
	<AnagramGame client:only="react" lang={lang as SupportedLanguageCode} />
</GameLayout>
