---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameSettingsPanel } from '@arcade/lib-ui';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';
import { TENTS_SETTINGS_CONFIG } from '../../config/settings';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentTents = resources[currentLanguage]?.tents ?? resources.en.tents;
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentTents.settings.title}
	subtitle={`${currentTents.title} — ${currentTents.settings.title}`}
	description={`${currentTents.title} - ${currentTents.settings.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentTents.title, href: `/tents/${currentLanguage}/` },
		{ label: currentTents.settings.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentTents.controls.play,
		href: `/tents/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentTents.controls.backToLobby,
		href: `/tents/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="settings"
>
	<GameSettingsPanel
		client:load
		config={TENTS_SETTINGS_CONFIG}
		lang={currentLanguage}
		mode="detailed"
	/>
</GameSubpageTemplate>
