---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameStatsDashboard } from '@arcade/lib-ui/components/GameStatsDashboard';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentColorFlood = resources[currentLanguage]?.['color-flood'] ?? resources.en['color-flood'];
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentCommon.stats.title}
	description={`${currentColorFlood.title} - ${currentCommon.stats.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentColorFlood.title, href: `/color-flood/${currentLanguage}/` },
		{ label: currentCommon.stats.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentColorFlood.lobby.play,
		href: `/color-flood/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentColorFlood.controls.backToLobby,
		href: `/color-flood/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="stats"
>
	<GameStatsDashboard
		client:load
		gameId="color-flood"
		lang={currentLanguage}
		hideTitle
		bucketLabels={{
			beginner: currentColorFlood.difficulty.beginner,
			easy: currentColorFlood.difficulty.easy,
			medium: currentColorFlood.difficulty.medium,
			hard: currentColorFlood.difficulty.hard,
		}}
		playHref={`/color-flood/${currentLanguage}/game`}
	/>
</GameSubpageTemplate>
