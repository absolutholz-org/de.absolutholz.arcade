---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { GameSettingsPanel } from '@arcade/lib-ui/components/GameSettingsPanel';
import GameSubpageTemplate from '@arcade/lib-ui/templates/GameSubpageTemplate/GameSubpageTemplate.astro';
import { LIQUID_SORT_SETTINGS_CONFIG } from '../../config/settings';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentLiquidSort = resources[currentLanguage]?.['liquid-sort'] ?? resources.en['liquid-sort'];
const currentCommon = resources[currentLanguage]?.common ?? resources.en.common;
---

<GameSubpageTemplate
	title={currentLiquidSort.settings.title}
	description={`${currentLiquidSort.title} - ${currentLiquidSort.settings.title}`}
	lang={currentLanguage}
	breadcrumbItems={[
		{ label: currentCommon.app.title, href: `/${currentLanguage}/`, isHome: true },
		{ label: currentLiquidSort.title, href: `/liquid-sort/${currentLanguage}/` },
		{ label: currentLiquidSort.settings.title, isCurrent: true },
	]}
	primaryAction={{
		label: currentLiquidSort.controls.play,
		href: `/liquid-sort/${currentLanguage}/game`,
	}}
	secondaryAction={{
		label: currentLiquidSort.controls.backToLobby,
		href: `/liquid-sort/${currentLanguage}/`,
	}}
	containerWidth="standard"
	currentSlug="settings"
>
	<GameSettingsPanel
		client:load
		config={LIQUID_SORT_SETTINGS_CONFIG}
		lang={currentLanguage}
		mode="detailed"
	/>
</GameSubpageTemplate>
