---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import { LiquidSortLobby } from '../../components/LiquidSortLobby';
import type { DifficultyLevel } from '../../engine/types.js';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLiquidSort = resources[lang as SupportedLanguageCode]?.['liquid-sort'] ?? resources.en['liquid-sort'];
const rawDiff = Astro.url.searchParams.get('difficulty') as DifficultyLevel | null;
const initialDifficulty = rawDiff && ['easy', 'medium', 'hard', 'expert'].includes(rawDiff) ? rawDiff : undefined;
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	titleOptions={{
		scope: currentLiquidSort.title,
	}}
	description={currentLiquidSort.description}
	lang={lang as SupportedLanguageCode}
	currentSlug=""
>
	<LiquidSortLobby client:load lang={lang as SupportedLanguageCode} initialDifficulty={initialDifficulty} />
</BaseLayoutWithSiteHeaderAndSiteFooter>
