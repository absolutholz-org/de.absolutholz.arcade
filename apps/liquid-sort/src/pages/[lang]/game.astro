---
import { getEntry } from 'astro:content';
import { resources } from '@arcade/lib-i18n/config/i18n';
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { MarkdownContent } from '@arcade/lib-ui/components/MarkdownContent';
import GameLayout from '@arcade/lib-ui/layouts/GameLayout/GameLayout.astro';
import { LiquidSortGame } from '../../components/LiquidSortGame';
import type { DifficultyLevel } from '../../engine/types.js';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentLiquidSort = resources[currentLanguage]?.['liquid-sort'] ?? resources.en['liquid-sort'];
const rawDiff = Astro.url.searchParams.get('difficulty') as DifficultyLevel | null;
const initialDifficulty = rawDiff && ['easy', 'medium', 'hard', 'expert'].includes(rawDiff) ? rawDiff : undefined;
const rawSeed = Astro.url.searchParams.get('seed');
const parsedSeed = rawSeed !== null ? Number.parseInt(rawSeed, 10) : Number.NaN;
const initialSeed = !Number.isNaN(parsedSeed) && parsedSeed > 0 ? parsedSeed : undefined;

const rulesEntry = (await getEntry('pages', `${lang}/rules`)) ?? (await getEntry('pages', `${DEFAULT_LANGUAGE}/rules`));
const renderedRules = rulesEntry ? await rulesEntry.render() : null;
const RulesContent = renderedRules?.Content;
---

<GameLayout
	titleOptions={{
		scope: currentLiquidSort.title,
		isPlaySession: true,
	}}
	description={currentLiquidSort.description}
	lang={currentLanguage}
	canonical={`https://arcade.absolutholz.de/liquid-sort/${lang}/game`}
	appTitle="Liquid Sort"
>
	<LiquidSortGame
		client:only="react"
		lang={currentLanguage}
		initialDifficulty={initialDifficulty}
		initialSeed={initialSeed}
	>
		<div slot="rulesContent">
			<MarkdownContent>
				{RulesContent && <RulesContent />}
			</MarkdownContent>
		</div>
	</LiquidSortGame>
</GameLayout>
