---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { WATERSORT_MEDAL_DEFINITIONS } from '@arcade/lib-medals';
import { PageContainer } from '@arcade/lib-ui/components/PageContainer';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import { WaterSortMedalGrid } from '../../components/WaterSortMedalGrid';
import type { WaterSortMedalDefinitionItem } from '../../components/WaterSortMedalGrid/WaterSortMedalGrid.types';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentLanguage = lang as SupportedLanguageCode;
const currentWatersort = resources[currentLanguage]?.watersort ?? resources.en.watersort;
const currentMedals = resources[currentLanguage]?.medals ?? resources.en.medals;

const staticMedals: WaterSortMedalDefinitionItem[] = WATERSORT_MEDAL_DEFINITIONS.map((def) => {
	const key = def.id.replace('watersort_', '') as keyof typeof currentMedals.watersort;
	const localized = currentMedals.watersort[key];
	let target: number | undefined;
	if (def.thresholds) {
		target = def.thresholds.gold;
	} else if (def.id === 'watersort_medium_clear' || def.id === 'watersort_hard_clear') {
		target = 5;
	} else if (def.id === 'watersort_master_suite' || def.id === 'watersort_color_cascade') {
		target = 4;
	} else if (def.id === 'watersort_comeback_kid') {
		target = 6;
	} else {
		target = 1;
	}

	return {
		id: def.id,
		type: def.type ?? 'standalone',
		tier: def.tier,
		title: localized?.title ?? def.id,
		description: localized?.desc ?? '',
		icon: def.icon,
		target,
		thresholds: def.thresholds,
	};
});
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	title={currentMedals.showcase.title}
	description={`${currentWatersort.title} - ${currentMedals.showcase.description}`}
	lang={currentLanguage}
	currentSlug="medals"
>
	<PageContainer variant="wide">
	<WaterSortMedalGrid client:load lang={currentLanguage} staticMedals={staticMedals} />
	</PageContainer>
</BaseLayoutWithSiteHeaderAndSiteFooter>
