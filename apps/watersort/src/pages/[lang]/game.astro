---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { WaterSortGame } from '../../components/WaterSortGame';
import type { DifficultyLevel } from '../../engine/types.js';
import WaterSortBaseLayout from '../../layouts/WaterSortBaseLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentWatersort = resources[lang as SupportedLanguageCode]?.watersort ?? resources.en.watersort;
const rawDiff = Astro.url.searchParams.get('difficulty') as DifficultyLevel | null;
const initialDifficulty = rawDiff && ['easy', 'medium', 'hard', 'expert'].includes(rawDiff) ? rawDiff : undefined;
const rawSeed = Astro.url.searchParams.get('seed');
const parsedSeed = rawSeed !== null ? Number.parseInt(rawSeed, 10) : Number.NaN;
const initialSeed = !Number.isNaN(parsedSeed) && parsedSeed > 0 ? parsedSeed : undefined;
---

<WaterSortBaseLayout
	title={`${currentWatersort.title} | ${currentWatersort.description}`}
	description={currentWatersort.description}
	lang={lang as SupportedLanguageCode}
	canonical={`https://arcade.absolutholz.de/watersort/${lang}/game`}
>
	<WaterSortGame
		client:only="react"
		lang={lang as SupportedLanguageCode}
		initialDifficulty={initialDifficulty}
		initialSeed={initialSeed}
	/>
</WaterSortBaseLayout>
