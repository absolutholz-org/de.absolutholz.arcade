---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import BaseLayoutWithSiteHeaderAndSiteFooter from '@arcade/lib-ui/layouts/BaseLayoutWithSiteHeaderAndSiteFooter/BaseLayoutWithSiteHeaderAndSiteFooter.astro';
import { NetLobby } from '../../components/NetLobby';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const currentNet = resources[lang as SupportedLanguageCode]?.net ?? resources.en.net;
---

<BaseLayoutWithSiteHeaderAndSiteFooter
	title={currentNet.title}
	description={currentNet.description}
	lang={lang as SupportedLanguageCode}
	currentSlug=""
>
	<NetLobby client:load lang={lang as SupportedLanguageCode} />
</BaseLayoutWithSiteHeaderAndSiteFooter>
