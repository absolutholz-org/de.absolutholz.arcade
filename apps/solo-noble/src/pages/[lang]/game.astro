---
import { resources } from '@arcade/lib-i18n/config/i18n';
import { SUPPORTED_LANGUAGES } from '@arcade/lib-i18n/constants/languages';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { SoloNobleGame } from '../../components/SoloNobleGame/SoloNobleGame';
import SoloNobleBaseLayout from '../../layouts/SoloNobleBaseLayout.astro';

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.map((item) => ({
		params: { lang: item.code },
	}));
}

const { lang } = Astro.params;
const current = resources[lang as SupportedLanguageCode]?.['solo-noble'] ?? resources.en['solo-noble'];
---

<SoloNobleBaseLayout
	title={`${current?.title ?? 'Solo Noble'} | ${current?.description}`}
	description={current?.description}
	lang={lang as SupportedLanguageCode}
	canonical={`https://arcade.absolutholz.de/solo-noble/${lang}/game`}
>
	<SoloNobleGame client:only="react" lang={lang as SupportedLanguageCode} />
</SoloNobleBaseLayout>
