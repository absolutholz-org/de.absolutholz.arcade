---
import { resources } from '@arcade/lib-i18n/config/i18n';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import BaseLayout from '@arcade/lib-ui/layouts/BaseLayout/BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	lang?: string;
	dir?: 'ltr' | 'rtl';
	canonical?: string;
}

const props = Astro.props;
const current = resources[(props.lang as SupportedLanguageCode) ?? 'en']?.['solo-noble'] ?? resources.en['solo-noble'];
---

<BaseLayout {...props} appTitle={current?.title ?? 'Solo Noble'}>
	<slot name="head" slot="head" />
	<slot />
</BaseLayout>
