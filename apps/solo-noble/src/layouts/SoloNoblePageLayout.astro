---
import { resources } from '@arcade/lib-i18n/config/i18n';
import type { SupportedLanguageCode } from '@arcade/lib-i18n/types/i18n.types';
import { HeaderUserMenu } from '@arcade/lib-ui/components/HeaderUserMenu';
import PageLayout from '@arcade/lib-ui/layouts/PageLayout/PageLayout.astro';

interface Props {
	title: string;
	description?: string;
	lang: SupportedLanguageCode;
	currentSlug?: string;
}

const { title, description, lang, currentSlug = '' } = Astro.props;
const current = resources[lang as SupportedLanguageCode]?.['solo-noble'] ?? resources.en['solo-noble'];
---

<PageLayout
	lang={lang}
	title={title}
	description={description || current?.description}
	appTitle={current?.title ?? 'Solo Noble'}
	appHomeHref={`/solo-noble/${lang}/`}
	basePath="solo-noble"
	currentSlug={currentSlug}
>
	<slot name="head" slot="head" />
	<slot name="header-actions" slot="header-actions">
		<HeaderUserMenu client:idle lang={lang} />
	</slot>
	<slot />
</PageLayout>
