{
	"name": "@arcade/monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"typecheck": "pnpm -r run --if-present typecheck",
		"dev:hub": "pnpm --filter @arcade/hub dev",
		"build:hub": "pnpm --filter @arcade/hub build",
		"preview:hub": "pnpm --filter @arcade/hub preview",
		"storybook:ui": "pnpm --filter @arcade/lib-ui storybook",
		"storybook": "pnpm --filter @arcade/lib-ui storybook"
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"typescript": "^5.7.2"
	}
}
