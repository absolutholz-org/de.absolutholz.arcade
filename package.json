{
	"name": "@arcade/monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --write --unsafe .",
		"prepare": "lefthook install",
		"typecheck": "pnpm -r run --if-present typecheck",
		"deploy:rules": "firebase deploy --only firestore:rules",
		"deploy:rules:dev": "firebase deploy --only firestore:rules --project default",
		"deploy:rules:prod": "firebase deploy --only firestore:rules --project production",
		"deploy:assemble": "node --experimental-strip-types .github/scripts/assemble-deployment.ts",
		"dev:hub": "pnpm --filter @arcade/hub dev",
		"build:hub": "pnpm --filter @arcade/hub build",
		"preview:hub": "pnpm --filter @arcade/hub preview",
		"dev:sudoku": "pnpm --filter @arcade/sudoku dev",
		"build:sudoku": "pnpm --filter @arcade/sudoku build",
		"preview:sudoku": "pnpm --filter @arcade/sudoku preview",
		"dev:bridges": "pnpm --filter @arcade/bridges dev",
		"build:bridges": "pnpm --filter @arcade/bridges build",
		"preview:bridges": "pnpm --filter @arcade/bridges preview",
		"dev:minesweeper": "pnpm --filter @arcade/minesweeper dev",
		"build:minesweeper": "pnpm --filter @arcade/minesweeper build",
		"preview:minesweeper": "pnpm --filter @arcade/minesweeper preview",
		"dev:nonogram": "pnpm --filter @arcade/nonogram dev",
		"build:nonogram": "pnpm --filter @arcade/nonogram build",
		"preview:nonogram": "pnpm --filter @arcade/nonogram preview",
		"dev:queens": "pnpm --filter @arcade/queens dev",
		"build:queens": "pnpm --filter @arcade/queens build",
		"preview:queens": "pnpm --filter @arcade/queens preview",
		"dev:tracks": "pnpm --filter @arcade/tracks dev",
		"build:tracks": "pnpm --filter @arcade/tracks build",
		"preview:tracks": "pnpm --filter @arcade/tracks preview",
		"dev:tents": "pnpm --filter @arcade/tents dev",
		"build:tents": "pnpm --filter @arcade/tents build",
		"preview:tents": "pnpm --filter @arcade/tents preview",
		"dev:anagram": "pnpm --filter @arcade/anagram dev",
		"build:anagram": "pnpm --filter @arcade/anagram build",
		"preview:anagram": "pnpm --filter @arcade/anagram preview",
		"storybook:ui": "pnpm --filter @arcade/lib-ui storybook",
		"storybook": "pnpm --filter @arcade/lib-ui storybook",
		"build:storybook": "turbo run build-storybook",
		"dev:watersort": "pnpm --filter @arcade/watersort dev",
		"build:watersort": "pnpm --filter @arcade/watersort build",
		"preview:watersort": "pnpm --filter @arcade/watersort preview",
		"dev:solonoble": "pnpm --filter @arcade/solonoble dev",
		"build:solonoble": "pnpm --filter @arcade/solonoble build",
		"preview:solonoble": "pnpm --filter @arcade/solonoble preview",
		"build:all": "pnpm build:hub && pnpm build:sudoku && pnpm build:minesweeper && pnpm build:nonogram && pnpm build:queens && pnpm build:bridges && pnpm build:storybook && pnpm build:tracks && pnpm build:tents && pnpm build:anagram && pnpm build:watersort && pnpm build:solonoble",
		"build": "turbo run build",
		"clean": "rm -rf apps/*/.astro apps/*/dist libraries/*/dist apps/*/node_modules/.vite node_modules/.vite node_modules/.cache"
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"lefthook": "^2.2.1",
		"turbo": "^2.11.10",
		"typescript": "^5.7.2"
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
