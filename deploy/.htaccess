# ==============================================================================
# Production Apache Configuration for arcade.absolutholz.de
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ----------------------------------------------------------------------------
  # 1. Enforce HTTPS
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------------
  # 2. Redirect www.arcade.absolutholz.de -> arcade.absolutholz.de
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.arcade\.absolutholz\.de$ [NC]
  RewriteRule ^(.*)$ https://arcade.absolutholz.de/$1 [R=301,L,NE]

  # ----------------------------------------------------------------------------
  # 3. Game Subdomain Redirection
  # Redirects [gamename].absolutholz.de to arcade.absolutholz.de/[gamename]/
  # Example: sudoku.absolutholz.de/en/ -> arcade.absolutholz.de/sudoku/en/
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.absolutholz\.de$ [NC]
  RewriteCond %{HTTP_HOST} !^(arcade|www)\.absolutholz\.de$ [NC]
  RewriteRule ^(.*)$ https://arcade.absolutholz.de/%1/$1 [R=301,L,NE]

  # ----------------------------------------------------------------------------
  # 4. Trailing Slash Normalization for Directories
  # Ensures directories like /sudoku or /storybook end with a trailing slash
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # ----------------------------------------------------------------------------
  # 5. Language Redirection (Hub & Per-Game Root Gateways)
  # Instant server-side 302 routing for visitors hitting / or /<game>/
  # ----------------------------------------------------------------------------
  # 5.1 Root Hub (/)
  RewriteCond %{HTTP_COOKIE} arcade_lang=(en|de|fr|pt) [NC]
  RewriteRule ^$ /%1/ [R=302,L]

  RewriteCond %{HTTP:Accept-Language} ^de [NC]
  RewriteRule ^$ /de/ [R=302,L]

  RewriteCond %{HTTP:Accept-Language} ^fr [NC]
  RewriteRule ^$ /fr/ [R=302,L]

  RewriteCond %{HTTP:Accept-Language} ^pt [NC]
  RewriteRule ^$ /pt/ [R=302,L]

  RewriteRule ^$ /en/ [R=302,L]

  # 5.2 Game Root (/<game>/)
  # Exclude known non-game directories like storybook or assets
  RewriteCond %{REQUEST_URI} !^/(storybook|_astro|assets|favicons)/ [NC]
  RewriteCond %{HTTP_COOKIE} arcade_lang=(en|de|fr|pt) [NC]
  RewriteRule ^([a-z0-9-]+)/$ /$1/%1/ [R=302,L]

  RewriteCond %{REQUEST_URI} !^/(storybook|_astro|assets|favicons)/ [NC]
  RewriteCond %{HTTP:Accept-Language} ^de [NC]
  RewriteRule ^([a-z0-9-]+)/$ /$1/de/ [R=302,L]

  RewriteCond %{REQUEST_URI} !^/(storybook|_astro|assets|favicons)/ [NC]
  RewriteCond %{HTTP:Accept-Language} ^fr [NC]
  RewriteRule ^([a-z0-9-]+)/$ /$1/fr/ [R=302,L]

  RewriteCond %{REQUEST_URI} !^/(storybook|_astro|assets|favicons)/ [NC]
  RewriteCond %{HTTP:Accept-Language} ^pt [NC]
  RewriteRule ^([a-z0-9-]+)/$ /$1/pt/ [R=302,L]

  RewriteCond %{REQUEST_URI} !^/(storybook|_astro|assets|favicons)/ [NC]
  RewriteRule ^([a-z0-9-]+)/$ /$1/en/ [R=302,L]
</IfModule>

# ------------------------------------------------------------------------------
# Compression (mod_deflate)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# Cache Expiration (mod_expires)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Long-lived caching for immutable build artifacts (1 year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Dynamic/Entry files should revalidate immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>

# ------------------------------------------------------------------------------
# HTTP Headers & Security (mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # 1-year immutable cache header for fingerprinted assets
  <FilesMatch "\.(js|css|woff2|woff|webp|svg|png|jpg|jpeg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Instant revalidation for HTML, PWA manifest, and configuration JSON
  <FilesMatch "\.(html|webmanifest|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
